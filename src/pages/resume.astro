---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { Picture } from 'astro:assets';
import pdfPage from '../assets/resume/resume-page.png';
const pdf = '/resume/Abtin-Aryanpour-Resume.pdf';

interface Task { title: string; href: string; repo: string; pr: string; points: string[] }
interface Entry { title: string; href?: string; meta: string; when: string; points?: string[]; text?: string; tasks?: Task[] }
const education: Entry[] = [{
  title: 'University of Waterloo',
  meta: 'Waterloo, ON. Candidate for BASc in Computer Engineering, Co-op Program.',
  when: 'September 2026 to April 2031',
}];
const projectEntries: Entry[] = [
  {
    title: 'Andon: machine-sound anomaly detection', href: '/projects/andon/',
    meta: 'Python, C, Raspberry Pi Pico 2', when: 'October 2026 to now',
    points: [
      'Developed a Pico 2 andon system that hears a fault through an I2S mic and cuts the fan’s power via a MOSFET, stopping each of 3 real fans by itself 3.461–11.661 s after an injected fault.',
      'Wrote real-time C firmware (I2S capture via PIO and DMA, FFT log-mel features, per-fan Gaussian mixture scoring) that matches Python’s scores on the board at 1.684 ms per 32 ms audio frame.',
      'Trained a PyTorch CNN on healthy audio only, reaching 92.13% mean AUC on held-out DCASE 2020 data against 79.70% for the baseline autoencoder I reproduced.',
      'Showed the model hears the sound’s shape, not just its volume: with every recording matched to normal loudness, a level meter fails but the model still caught both faults on every fan (dev data).',
      'Quantized the CNN to int8 (383.0 KB to 98.7 KB at 92.08% AUC) and ported it to C, bit-exact with Python on the Pico 2’s Cortex-M33.',
    ],
  },
  {
    title: 'CyberShield: full-stack discussion forum', href: 'https://github.com/abtinmbm/cybershield',
    meta: 'Python, Django, JavaScript, Tailwind CSS', when: '2025',
    points: [
      'Built a full-stack forum as the only developer on a 3-person team using Django, jQuery (AJAX) and SQLite, winning 1st of 32 teams at CNLC 2025.',
      'Implemented voting, sorting, filtering and fuzzy search (Fuse.js) through JSON endpoints, with no page reloads.',
      'Secured accounts with Django auth, CSRF protection, reCAPTCHA and moderator roles, and deployed on AWS.',
    ],
  },
];
const experience: Entry[] = [
  {
    title: 'Autonomy Software Member', meta: 'Waterloo Aerial Robotics Group, Waterloo, ON', when: 'September 2026 to now',
    tasks: [{
    title: 'Groundside image stitcher', href: '/projects/image-stitcher/', repo: 'https://github.com/UWARG/autonomy-monorepo/pull/215', pr: 'Pull request #215 (merged)',
    points: [
      'Built a Python stitcher (PyTorch, OpenCV, XFeat, RANSAC) that merges out-of-order, GPS-tagged photos from 3 drones into one georeferenced map. Sole developer, merged with 130 tests.',
      'Designed a joint least-squares pose refinement that cut mean simulated misalignment from 13.6–69.8 cm to 4.0–8.3 cm.',
      'Solved feature matching across 180° row turns, then used drone yaw to extract features once per photo, cutting simulated time per photo from 0.42–0.75 s to 0.13–0.19 s.',
      'Implemented lens undistortion and blur, exposure and tilt checks that keep unusable photos out of the map.',
    ],
    }, {
    title: 'Swarm spacing (Lloyd’s algorithm)', href: '/projects/lloyd/', repo: 'https://github.com/UWARG/autonomy-monorepo/pull/247', pr: 'Pull request #247 (in review)',
    points: [
      'Built a swarm-spacing module (Lloyd’s algorithm, Voronoi cells, Shapely) that spreads drones evenly over concave, GPS-bounded fields, cutting spacing variation (CV) from 0.46 to 0.06 in simulation.',
    ],
    }],
  },
  {
    title: 'Homework Helper and Assistant Teacher', meta: 'Spirit of Math Schools Inc., Richmond Hill, ON', when: 'September 2022 to July 2025',
    points: [
      'Ran a drop-in homework classroom as one of two staff (2024–2025), helping about 30 students per session.',
      'Taught 1–2 classes a week of up to 16 students (2022–2024), covering lessons and contest-style algebra.',
    ],
  },
];
const awards = [
  'Canadian National Leadership Conference: 1st place (2025) and 4th place (2024), Coding & Programming',
  'Waterloo Math Contests, 2025–26: Euclid (86/100), Hypatia (33/40) Honour Roll; Fermat, CSMC Distinction',
  'Bayview Secondary School: Excellence in Mathematics (2025, 2026)',
];
const skills = [
  ['Languages', 'C, Python, C++, Java, JavaScript, SQL'],
  ['Embedded and DSP', 'Pico SDK, Arm Cortex-M33, PIO, DMA, I2S, PWM, watchdog, fixed-point math, FFT, log-mel'],
  ['ML and vision', 'PyTorch, scikit-learn, OpenCV, NumPy, CNNs, Gaussian mixtures, int8 quantization, RANSAC'],
  ['Tools and platforms', 'Git, GitHub Actions (CI), CMake, pytest, Django, SQLite, AWS EC2'],
];
---
<Base
  title="Resume | Abtin Aryanpour"
  description="The resume of Abtin Aryanpour, first-year Computer Engineering at the University of Waterloo: projects, experience, skills and awards, with a PDF to download."
  current="resume"
>
  <div class="cv wrap grid">
    <header class="cv-side">
      <h1 class="display">Resume</h1>
      <p class="who">Abtin Aryanpour<br /><span class="dim">Computer Engineering, University of Waterloo</span></p>
      <p class="get"><a href={pdf} target="_blank" rel="noopener">Open the PDF in a new tab</a><a class="small" href={pdf} download>Download it (one page, 116&nbsp;KB)</a></p>
      <ul class="reach">
        <li><a href="mailto:aaryanpo@uwaterloo.ca"><Icon name="mail" />aaryanpo@uwaterloo.ca</a></li>
        <li><a href="https://www.linkedin.com/in/abtin-aryanpour"><Icon name="linkedin" />linkedin.com/in/abtin-aryanpour</a></li>
        <li><a href="https://github.com/abtinmbm"><Icon name="github" />github.com/abtinmbm</a></li>
      </ul>
    </header>

    <div class="cv-main">
      <div class="views" role="tablist" aria-label="How to read the resume" hidden>
        <button type="button" role="tab" id="tab-web" aria-controls="view-web" aria-selected="true">Web version</button>
        <button type="button" role="tab" id="tab-pdf" aria-controls="view-pdf" aria-selected="false" tabindex="-1">PDF version</button>
      </div>

      <div class="view" id="view-web" role="tabpanel" aria-labelledby="tab-web">
      <section aria-labelledby="edu">
        <h2 id="edu">Education</h2>
        {education.map((e) => (
          <div class="entry">
            <div class="e-head"><h3>{e.title}</h3><p class="when">{e.when}</p></div>
            <p class="meta">{e.meta}</p>
            {e.text && <p>{e.text}</p>}
          </div>
        ))}
      </section>

      <section aria-labelledby="skills">
        <h2 id="skills">Technical skills</h2>
        <dl class="skills">
          {skills.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </section>

      <section aria-labelledby="exp">
        <h2 id="exp">Experience</h2>
        {experience.map((e) => (
          <div class="entry">
            <div class="e-head"><h3>{e.href ? <a href={e.href}>{e.title}</a> : e.title}</h3><p class="when">{e.when}</p></div>
            <p class="meta">{e.meta}</p>
            {e.points && <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>}
            {e.tasks?.map((t) => (
              <div class="task">
                <div class="e-head"><h4><a href={t.href}>{t.title}</a></h4><a class="pr" href={t.repo}><Icon name="github" />{t.pr}</a></div>
                <ul>{t.points.map((pt) => <li>{pt}</li>)}</ul>
              </div>
            ))}
          </div>
        ))}
      </section>

      <section aria-labelledby="projects">
        <h2 id="projects">Projects</h2>
        {projectEntries.map((e) => (
          <div class="entry">
            <div class="e-head"><h3><a href={e.href}>{e.title}</a></h3><p class="when">{e.when}</p></div>
            <p class="meta">{e.meta}</p>
            <ul>{e.points!.map((pt) => <li>{pt}</li>)}</ul>
          </div>
        ))}
      </section>

      <section aria-labelledby="awards">
        <h2 id="awards">Awards</h2>
        <ul>{awards.map((a) => <li>{a}</li>)}</ul>
      </section>
      </div>

      <div class="view view-pdf" id="view-pdf" role="tabpanel" aria-labelledby="tab-pdf">
        <a class="sheet" href={pdf} target="_blank" rel="noopener">
          <Picture src={pdfPage} formats={['avif', 'webp']} fallbackFormat="webp" widths={[700, 1100, 1700]} sizes="(max-width: 899px) 100vw, 60vw"
            alt="The one-page resume PDF: education, technical skills, projects (Andon and CyberShield), experience (Waterloo Aerial Robotics Group and Spirit of Math) and awards." loading="lazy" />
        </a>
        <p class="small dim">The same page as the PDF. Click it to open the PDF, where the links work.</p>
      </div>

    </div>
  </div>
</Base>

<script>
  // Two views of one resume. Without JavaScript both show, one after the other.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.views [role="tab"]')];
  const list = document.querySelector<HTMLElement>('.views');
  if (list && tabs.length) {
    list.hidden = false;
    const pick = (t: HTMLButtonElement, focus = false) => {
      for (const o of tabs) {
        const on = o === t;
        o.setAttribute('aria-selected', String(on));
        o.tabIndex = on ? 0 : -1;
        document.getElementById(o.getAttribute('aria-controls')!)!.hidden = !on;
      }
      if (focus) t.focus();
      history.replaceState(null, '', t.id === 'tab-pdf' ? '#pdf' : location.pathname);
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(t));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        e.preventDefault();
        pick(tabs[(i + 1) % tabs.length], true);
      });
    });
    pick(location.hash === '#pdf' ? tabs[1] : tabs[0]);
  }
</script>

<style>
  .cv { padding-block: var(--page-top) var(--page-end); align-items: start; }
  /* The left column stays in view while the resume scrolls past it. */
  .cv-side { grid-column: 1 / 4; position: sticky; top: var(--s6); display: grid; gap: var(--s5); }
  h1 { font-size: var(--t-h2); line-height: 1; letter-spacing: 0.01em; }
  .who { line-height: 1.5; }
  .get { display: grid; gap: var(--s2); justify-items: start; }
  .get a { font-weight: 500; }
  .reach { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s3); font-size: 15px; }
  .reach a { display: inline-flex; align-items: center; gap: var(--s3); overflow-wrap: anywhere; }
  .reach :global(.icon) { color: var(--dim); width: 17px; height: 17px; }

  .cv-main { grid-column: 5 / 13; display: grid; gap: var(--group); max-width: 54rem; }
  .view { display: grid; gap: var(--group); }
  .view[hidden] { display: none; }
  .views { display: inline-flex; justify-self: start; padding: 4px; gap: 4px; border: 1px solid var(--line); border-radius: 999px; }
  .views[hidden] { display: none; }
  .views button { font: inherit; font-size: 15px; font-weight: 500; color: var(--dim); background: none; border: 0; border-radius: 999px; padding: 8px 18px; cursor: pointer; transition: color 160ms ease, background-color 160ms ease; }
  .views button:hover { color: var(--white); }
  .views button[aria-selected="true"] { background: var(--white); color: var(--black); }
  .views button:focus-visible { outline: 2px solid var(--white); outline-offset: 3px; }
  .view-pdf { gap: var(--s4); }
  .sheet { display: block; background: #fff; box-shadow: 0 30px 80px -30px rgb(13 34 87 / 0.9); }
  .sheet :global(img) { width: 100%; height: auto; }
  section { display: grid; gap: var(--s5); }
  h2 { font-size: 15px; font-weight: 500; color: var(--dim); padding-bottom: var(--s3); border-bottom: 1px solid var(--line); }
  .entry { display: grid; gap: 4px; }
  .entry + .entry { margin-top: var(--s4); }
  .e-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px var(--s5); }
  h3 { font-size: 18px; font-weight: 500; }
  .when { color: var(--dim); font-size: 15px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .meta { color: var(--dim); font-size: 15px; }
  .task { margin-top: var(--s4); padding-left: var(--s4); border-left: 1px solid var(--line); }
  h4 { font-size: 16px; font-weight: 500; }
  .pr { display: inline-flex; align-items: center; gap: var(--s2); color: var(--dim); font-size: 15px; }
  .pr :global(.icon) { width: 15px; height: 15px; }
  ul { margin: var(--s2) 0 0; padding-left: 1.1em; display: grid; gap: var(--s2); max-width: 36em; }
  li::marker { color: var(--dim); }
  .skills { margin: 0; display: grid; gap: var(--s3); }
  .skills div { display: grid; grid-template-columns: 13em 1fr; gap: var(--s4); }
  .skills dt { font-weight: 500; }
  .skills dd { margin: 0; color: var(--dim); }

  @media (max-width: 899px) {
    .cv { row-gap: var(--s6); }
    .cv-side, .cv-main { grid-column: 1 / -1; }
    .cv-side { position: static; }
  }
  @media (max-width: 599px) {
    .skills div { grid-template-columns: 1fr; gap: 2px; }
    .when { white-space: normal; }
  }
</style>
