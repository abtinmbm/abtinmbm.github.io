---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
const pdf = '/resume/Abtin-Aryanpour-Resume.pdf';

interface Entry { title: string; href?: string; meta: string; when: string; points?: string[]; text?: string }
const education: Entry[] = [{
  title: 'University of Waterloo',
  meta: 'Waterloo, ON. Candidate for BASc in Computer Engineering, Co-op Program.',
  when: 'Expected April 2031',
  text: 'Coursework: Fundamentals of Programming (C++), Linear Algebra, Calculus, Mechanics, Engineering Design',
}];
const projectEntries: Entry[] = [
  {
    title: 'Andon: machine-sound anomaly detection', href: '/projects/andon/',
    meta: 'Python, PyTorch, C, Pico 2', when: 'October 2026 to now',
    points: [
      'Built a machine-sound anomaly detector trained only on healthy audio: a 98k-weight CNN reached 92.13% mean AUC on the held-out DCASE 2020 evaluation set, against 79.70% for the reference autoencoder (3 seeds).',
      'Reproduced the published DCASE baseline in PyTorch within 0.88 AUC points on all 6 machine types, and released checkpoints so two commands re-check the held-out CNN results from a fresh clone.',
      'Turned scores into an andon light with SPC control limits, hysteresis and a Streamlit dashboard. On the held-out evaluation clips it caught 65.57% of 30 s faults, on average 10.57 s after onset, at 5.53 false alarms per hour.',
      'Quantized the CNN to int8 for a Cortex-M33 with a custom fixed-point reference: 98.7 KB (from 383.0 KB) at 92.08% held-out AUC, exporting C headers and test vectors in CI. Now porting to a Raspberry Pi Pico 2.',
    ],
  },
  {
    title: 'Image Stitcher, Waterloo Aerial Robotics Group', href: '/projects/image-stitcher/',
    meta: 'Python, PyTorch, OpenCV. Pull request #215', when: 'October 2026 to now',
    points: [
      'Developed a groundside orthomosaic stitcher on the autonomy subteam, merging out-of-order, GPS-tagged photos from 3 simulated drones into one georeferenced map using XFeat learned features and RANSAC.',
      'Fused images with noisy GPS to recover heading, aligning photos within 6.9 cm at 3 m of simulated GPS error.',
      'Designed a bundle-adjustment-style least-squares solver, cutting simulated misalignment from 13–41 cm to 4–7 cm.',
      'Handled 180-degree turns and repetitive terrain, forming one map on 10 of 10 simulated 91-photo missions.',
      'Added lens undistortion and blur, exposure and tilt checks, and built a ground-truth mission simulator and 80 tests.',
    ],
  },
  {
    title: 'CyberShield: full-stack discussion forum', href: 'https://github.com/abtinmbm/cybershield',
    meta: 'Python, Django, JavaScript, Tailwind CSS', when: 'March 2025',
    points: [
      'Sole developer of a responsive forum where users post, comment and vote, with sorting, topic filtering and fuzzy search (Fuse.js), built on Django, jQuery (AJAX) and SQLite.',
      'Secured accounts with Django authentication, CSRF protection and reCAPTCHA on login and signup, and added rich-text posts (CKEditor) and profile picture uploads.',
      'Deployed live behind AWS CloudFront with a seeded demo dataset. Won 1st place in Coding & Programming at the Canadian National Leadership Conference 2025 (32 teams).',
    ],
  },
];
const experience: Entry[] = [
  {
    title: 'Treasurer', meta: 'Bayview Secondary School, Richmond Hill, ON', when: 'September 2025 to June 2026',
    points: [
      'Managed a $21,000 student budget across 42 clubs serving 2,000 students.',
      'Reviewed and approved each club’s budget, calculating allocations and negotiating changes in meetings with club presidents and school administrators.',
    ],
  },
  {
    title: 'Homework Helper and Assistant Teacher', meta: 'Spirit of Math Schools Inc., Richmond Hill, ON', when: 'September 2022 to July 2025',
    points: [
      'Homework Helper (2024–2025): ran a drop-in homework help classroom as one of two staff, triaging questions from students ranging from kindergarten to Grade 11 and diagnosing where each one was stuck.',
      'Assistant Teacher (2022–2024): supported classes of 16 students, teaching lessons and contest-style algebra.',
    ],
  },
];
const skills = [
  ['Languages', 'Python, C/C++, Java, JavaScript, SQL, HTML/CSS'],
  ['Frameworks and libraries', 'PyTorch, NumPy, OpenCV, scikit-learn, Django, Streamlit, jQuery'],
  ['Tools and platforms', 'Git, GitHub Actions (CI), pytest, uv, CMake, SQLite, AWS (EC2, CloudFront)'],
];
const awards = [
  '1st place (2025, CNLC) and 4th place (2024, FBLA), Coding & Programming, national competitions',
  'Euclid (86) and Hypatia (33) Honour Roll, and Fermat and CSMC Distinction, University of Waterloo, 2025–2026',
  'Excellence in Mathematics, Bayview Secondary School Mathematics Department, 2025 and 2026',
];
---
<Base
  title="Resume | Abtin Aryanpour"
  description="The resume of Abtin Aryanpour, first-year Computer Engineering at the University of Waterloo: projects, experience, skills and awards, with a PDF to download."
  current="resume"
>
  <div class="cv wrap grid">
    <header class="cv-side">
      <h1 class="display">Resume</h1>
      <p class="who">Abtin Aryanpour<br /><span class="dim">Computer Engineering, University of Waterloo</span></p>
      <a class="get" href={pdf} download><Icon name="file" /><span>Download the PDF<span class="small dim">One page, 119&nbsp;KB</span></span></a>
      <ul class="reach">
        <li><a href="mailto:aaryanpo@uwaterloo.ca"><Icon name="mail" />aaryanpo@uwaterloo.ca</a></li>
        <li><a href="https://www.linkedin.com/in/abtin-aryanpour"><Icon name="linkedin" />linkedin.com/in/abtin-aryanpour</a></li>
        <li><a href="https://github.com/abtinmbm"><Icon name="github" />github.com/abtinmbm</a></li>
      </ul>
    </header>

    <div class="cv-main">
      <section aria-labelledby="edu">
        <h2 id="edu">Education</h2>
        {education.map((e) => (
          <div class="entry">
            <div class="e-head"><h3>{e.title}</h3><p class="when">{e.when}</p></div>
            <p class="meta">{e.meta}</p>
            <p>{e.text}</p>
          </div>
        ))}
      </section>

      <section aria-labelledby="skills">
        <h2 id="skills">Technical skills</h2>
        <dl class="skills">
          {skills.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </section>

      <section aria-labelledby="projects">
        <h2 id="projects">Projects</h2>
        {projectEntries.map((e) => (
          <div class="entry">
            <div class="e-head"><h3><a href={e.href}>{e.title}</a></h3><p class="when">{e.when}</p></div>
            <p class="meta">{e.meta}</p>
            <ul>{e.points!.map((pt) => <li>{pt}</li>)}</ul>
          </div>
        ))}
      </section>

      <section aria-labelledby="exp">
        <h2 id="exp">Experience</h2>
        {experience.map((e) => (
          <div class="entry">
            <div class="e-head"><h3>{e.title}</h3><p class="when">{e.when}</p></div>
            <p class="meta">{e.meta}</p>
            <ul>{e.points!.map((pt) => <li>{pt}</li>)}</ul>
          </div>
        ))}
      </section>

      <section aria-labelledby="awards">
        <h2 id="awards">Awards</h2>
        <ul>{awards.map((a) => <li>{a}</li>)}</ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .cv { padding-block: var(--s8) var(--s9); align-items: start; }
  /* The left column stays in view while the resume scrolls past it. */
  .cv-side { grid-column: 1 / 4; position: sticky; top: var(--s6); display: grid; gap: var(--s5); }
  h1 { font-size: var(--t-h2); line-height: 1; letter-spacing: -0.01em; }
  .who { line-height: 1.5; }
  .get { display: flex; align-items: center; gap: var(--s4); padding: var(--s4) var(--s5); border: 1px solid rgb(243 245 255 / 0.4); border-radius: 10px;
    text-decoration: none; font-weight: 500; transition: border-color 160ms ease, background-color 160ms ease; }
  .get :global(.icon) { width: 22px; height: 22px; }
  .get > span { display: grid; gap: 2px; }
  .get:hover { border-color: var(--white); background: rgb(243 245 255 / 0.06); }
  .get:focus-visible { outline: 2px solid var(--white); outline-offset: 3px; }
  .get:active { background: rgb(243 245 255 / 0.12); }
  .reach { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s3); font-size: 15px; }
  .reach a { display: inline-flex; align-items: center; gap: var(--s3); overflow-wrap: anywhere; }
  .reach :global(.icon) { color: var(--dim); width: 17px; height: 17px; }

  .cv-main { grid-column: 5 / 13; display: grid; gap: var(--s7); max-width: 54rem; }
  section { display: grid; gap: var(--s5); }
  h2 { font-family: var(--display); font-size: 15px; font-weight: 500; letter-spacing: 0.02em; color: var(--dim); padding-bottom: var(--s3); border-bottom: 1px solid var(--line); }
  .entry { display: grid; gap: 4px; }
  .entry + .entry { margin-top: var(--s4); }
  .e-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px var(--s5); }
  h3 { font-size: 18px; font-weight: 500; }
  .when { color: var(--dim); font-size: 15px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .meta { color: var(--dim); font-size: 15px; }
  ul { margin: var(--s2) 0 0; padding-left: 1.1em; display: grid; gap: var(--s2); max-width: 46em; }
  li::marker { color: var(--dim); }
  .skills { margin: 0; display: grid; gap: var(--s3); }
  .skills div { display: grid; grid-template-columns: 13em 1fr; gap: var(--s4); }
  .skills dt { font-weight: 500; }
  .skills dd { margin: 0; color: var(--dim); }

  @media (max-width: 899px) {
    .cv { padding-top: var(--s6); row-gap: var(--s7); }
    .cv-side, .cv-main { grid-column: 1 / -1; }
    .cv-side { position: static; }
    .get { width: fit-content; }
  }
  @media (max-width: 599px) {
    .skills div { grid-template-columns: 1fr; gap: 2px; }
    .when { white-space: normal; }
  }
</style>
