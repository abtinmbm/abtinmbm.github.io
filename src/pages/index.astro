---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import StarTrails from '../components/StarTrails.astro';
import Icon from '../components/Icon.astro';
import AndonReplay from '../components/AndonReplay.astro';
import { projects } from '../data/projects';
import { andon, stitcher, lloyd, awards } from '../data/metrics';
import StatusBadge from '../components/StatusBadge.astro';
import lloydRun from '../data/lloyd-run.json';
import { stepMarkup, viewBox as lloydBox, type LloydRun } from '../lib/lloyd';
import '../styles/lloyd.css';
const repo = (slug: string) => projects.find((x) => x.slug === slug)!.repo;
import portrait from '../assets/photos/abtin-portrait.jpg';
import mapStage from '../assets/stitcher/stages/stage-20.webp';

const trailProjects = projects.map((p) => ({
  name: p.name,
  line: p.line,
  link: p.href ?? `#${p.slug}`,
  start: p.start,
  end: p.end,
}));
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Abtin Aryanpour',
  url: 'https://abtinmbm.github.io/',
  email: 'mailto:aaryanpo@uwaterloo.ca',
  description: 'First-year Computer Engineering student at the University of Waterloo.',
  affiliation: [
    { '@type': 'CollegeOrUniversity', name: 'University of Waterloo' },
    { '@type': 'Organization', name: 'Waterloo Aerial Robotics Group' },
  ],
  sameAs: ['https://github.com/abtinmbm', 'https://www.linkedin.com/in/abtin-aryanpour'],
};
---
<Base
  title="Abtin Aryanpour, Computer Engineering at Waterloo"
  description="First-year Computer Engineering student at the University of Waterloo. Looking for a co‑op, May to August 2027."
  overlay
  current="home"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <section class="hero" aria-labelledby="hero-name">
    <div class="sky">
      <StarTrails projects={trailProjects} />
    </div>
    <div class="who">
      <h1 id="hero-name" class="display">Abtin Aryanpour</h1>
      <div class="who-text">
        <p>First-year Computer Engineering student at the University of Waterloo.</p>
        <p class="avail">Looking for a co&#8209;op, May to August 2027.</p>
      </div>
    </div>
  </section>

  <section class="intro wrap grid" aria-labelledby="intro-h">
    <Picture pictureAttributes={{ class: "portrait" }} src={portrait} alt="Abtin at a formal event in a suit and bow tie, pointing at the camera" widths={[360, 560, 820]} sizes="(max-width: 759px) 60vw, 40vw" formats={['avif', 'webp']} />
    <div class="intro-text">
      <h2 id="intro-h" class="head">About me</h2>
      <p class="lead">I’m Abtin. I’m in first-year Computer Engineering at the University of Waterloo, on the autonomy software team at the Waterloo Aerial Robotics Group.</p>
      <p><a href="/about/">More about me</a></p>
    </div>
  </section>

  <section id="work" class="work" aria-labelledby="work-h">
    <h2 id="work-h" class="visually-hidden">Projects</h2>

    <article id="andon" class="p-andon wrap grid" aria-labelledby="andon-h">
      <div class="p-text">
        <h3 id="andon-h" class="head">Andon</h3>
        <p class="lead">Hears when a machine starts to sound wrong, after learning only from healthy recordings.</p>
        <p class="status"><b>In progress.</b> A solo project. The software works. Now it’s moving onto a Raspberry Pi Pico 2.</p>
        <p>Played a faulty recording and a healthy one it has never heard, it picks the faulty one {andon.meanAuc} of the time ({andon.meanAuc} AUC), against {andon.baselineAuc} for the challenge’s own baseline model. Shrunk to {andon.int8Size}, it fits on a microcontroller.</p>
        <p class="p-links"><a href="/projects/andon/">Read about Andon</a><a href={repo('andon')}>Code on GitHub<span class="visually-hidden"> for Andon</span></a></p>
      </div>
      <div class="p-media">
        <AndonReplay captionId="andon-cap">
          <figcaption id="andon-cap" class="small">A replay of one fan’s real scores, from the development test clips: two minutes of normal running, then a fault. This machine was picked to show how the light works.</figcaption>
        </AndonReplay>
      </div>
    </article>

    <div class="team" role="group" aria-labelledby="warg-h">
    <p id="warg-h" class="team-head wrap"><span>Waterloo Aerial Robotics Group</span><span class="dim">Autonomy Software Member, since September 2026</span></p>
    <article id="image-stitcher" class="p-stitch" aria-labelledby="stitch-h">
      <figure class="p-map wrap">
        <Picture pictureAttributes={{ class: "p-bleed" }} src={mapStage} fallbackFormat="webp" alt="A map stitched from the first 20 of 91 simulated drone photos. Its stepped outline shows where the photos landed, with gaps where photos haven’t arrived yet." widths={[800, 1200, 1664]} sizes="(max-width: 759px) 100vw, 56vw" formats={['avif', 'webp']} />
        <figcaption class="cap small">One simulated mission, after 20 of its {stitcher.photos} photos. The stepped outline is the edge of the stitched photos, the gaps are ground no photo has covered yet, and only the painted ground markers are kept inside.</figcaption>
      </figure>
      <div class="p-text wrap">
        <h3 id="stitch-h" class="head">Image Stitcher</h3>
        <p class="lead">Merges out-of-order, GPS-tagged photos from several drones into one top-down map, for the Waterloo Aerial Robotics Group.</p>
        <p class="status"><StatusBadge slug="image-stitcher" /> I built it on the autonomy software team, and the subteam is reviewing pull request #215.</p>
        <p>In {stitcher.missions} simulated missions it built one connected map, with photos lined up to {stitcher.alignment} on average.</p>
        <p class="p-links"><a href="/projects/image-stitcher/">Read about the stitcher</a><a href={repo('image-stitcher')}>Code on GitHub (PR #215)<span class="visually-hidden"> for the Image Stitcher</span></a></p>
      </div>
    </article>

    <ul class="tasks wrap" aria-label="More tasks at the Waterloo Aerial Robotics Group">
      <li id="lloyd" class="task">
        <svg class="task-fig" viewBox={lloydBox} role="img" aria-label="Ten simulated drones spread evenly over an L-shaped field, each in its own cell, with the paths they flew from a bunched start." set:html={stepMarkup(lloydRun as LloydRun, (lloydRun as LloydRun).frames.length - 1)} />
        <div class="task-text">
          <h3 class="head">Lloyd’s algorithm</h3>
          <p>Spreads a drone swarm evenly over any field with a GPS boundary.</p>
          <p class="status"><StatusBadge slug="lloyd" /> Pull request #247.</p>
          <p class="small">In {lloyd.runs} simulated runs, spacing unevenness fell from {lloyd.cvStart} to {lloyd.cvEnd} (0 is perfectly even).</p>
          <p class="p-links"><a href="/projects/lloyd/">Read about it</a><a href={repo('lloyd')}>Code on GitHub (PR #247)<span class="visually-hidden"> for Lloyd’s algorithm</span></a></p>
        </div>
      </li>
    </ul>
    </div>

  </section>

  <section class="earlier wrap" aria-labelledby="earlier-h">
    <h2 id="earlier-h" class="head">Before Waterloo</h2>
    <ul>
      <li id="cybershield">
        <h3>CyberShield</h3>
        <p>A Django cybersecurity forum.</p>
        <p class="dim">{awards.fblc2025}</p>
        <a href="https://github.com/abtinmbm/cybershield">Code on GitHub<span class="visually-hidden"> for CyberShield</span></a>
      </li>
      <li id="school-partner-directory">
        <h3>School Partner Directory</h3>
        <p>A Django directory for linking a school with local partners, seeded with 25 sample organizations.</p>
        <p class="dim">{awards.fbla2024}</p>
        <a href="https://github.com/abtinmbm/FBLA2024">Code on GitHub<span class="visually-hidden"> for School Partner Directory</span></a>
      </li>
    </ul>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-h">
    <div class="c-inner wrap grid">
      <div class="c-side">
        <h2 id="contact-h" class="head">Contact</h2>
        <p>Looking for a co&#8209;op, May to August 2027.</p>
      </div>
      <div class="c-main">
        <a class="c-mail" href="mailto:aaryanpo@uwaterloo.ca" data-copy="aaryanpo@uwaterloo.ca">
          <span class="c-addr">aaryanpo@uwaterloo.ca</span>
          <span class="c-hint small"><span class="c-hint-copy"><Icon name="copy" /> Click to copy</span><span class="c-hint-done"><Icon name="check" /> Copied to clipboard</span></span>
        </a>
        <p class="c-alt small"><a href="mailto:aaryanpo@uwaterloo.ca">Open in your mail app</a></p>
        <span class="visually-hidden" aria-live="polite" data-copy-status></span>
        <ul class="c-links">
          <li><a href="https://github.com/abtinmbm"><Icon name="github" class="c-ico" /><span class="c-name">GitHub</span><span class="c-sub small">github.com/abtinmbm</span></a></li>
          <li><a href="https://www.linkedin.com/in/abtin-aryanpour"><Icon name="linkedin" class="c-ico" /><span class="c-name">LinkedIn</span><span class="c-sub small">in/abtin-aryanpour</span></a></li>
          <li><a href="/resume/"><Icon name="file" class="c-ico" /><span class="c-name">Resume</span><span class="c-sub small">One page, with a PDF</span></a></li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  // Clicking the address copies it. If the browser won't allow that, the link opens the mail app as usual.
  const mail = document.querySelector<HTMLAnchorElement>('[data-copy]');
  const status = document.querySelector('[data-copy-status]');
  let t = 0;
  mail?.addEventListener('click', async (e) => {
    if (!navigator.clipboard) return;
    e.preventDefault();
    try {
      await navigator.clipboard.writeText(mail.dataset.copy!);
    } catch {
      location.href = mail.href;
      return;
    }
    mail.classList.add('copied');
    if (status) status.textContent = 'Email address copied to the clipboard';
    clearTimeout(t);
    t = window.setTimeout(() => { mail.classList.remove('copied'); if (status) status.textContent = ''; }, 2200);
  });
</script>

<style>
  /* first screen */
  .hero { position: relative; height: 100svh; min-height: 820px; overflow: hidden;
    background: radial-gradient(120% 90% at 30% 120%, var(--glow), var(--deep) 45%, var(--black) 85%); }
  .sky { position: absolute; inset: 0; }
  .hero::after { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to top, rgb(1 3 10 / 0.94) 0%, rgb(1 3 10 / 0.86) 30%, rgb(1 3 10 / 0.5) 44%, transparent 58%); }
  .who { position: absolute; z-index: 3; left: var(--edge); right: var(--edge); bottom: var(--edge);
    text-shadow: 0 0 6px var(--black), 0 0 18px var(--black); }
  .who h1 { font-size: var(--t-name); line-height: 1; letter-spacing: 0; white-space: nowrap; margin-bottom: var(--s5); }
  .who-text p { max-width: 46ch; }
  .who .avail { margin-top: var(--s3); font-weight: 500; }

  /* intro */
  .intro { padding-block: var(--s9) var(--s8); align-items: center; }
  :global(.portrait) { grid-column: 1 / 6; display: block; }
  :global(.portrait img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .intro-text { grid-column: 7 / 13; display: grid; gap: var(--s4); max-width: 36em; }
  .intro-text h2 { font-size: var(--t-h2); line-height: 1.05; }
  .lead { font-size: var(--t-lead); line-height: 1.4; }
  /* Section headings use the body face; the wide display face is kept for page titles. */
  .head { font-weight: 500; letter-spacing: -0.015em; }

  /* projects */
  .work { display: grid; gap: var(--s9); padding-bottom: var(--s9); }
  .p-text { display: grid; gap: var(--s4); align-content: start; }
  .p-text h3 { font-size: var(--t-h2); line-height: 1.05; }
  .status b { font-weight: 500; }
  .status { color: var(--dim); }
  .status b { color: var(--white); }
  .p-links { display: flex; flex-wrap: wrap; gap: var(--s2) var(--s5); }

  .p-andon { align-items: center; }
  .p-andon .p-text { grid-column: 1 / 6; }
  .p-media { grid-column: 7 / 13; }

  .p-stitch { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); padding-inline: var(--edge); align-items: center; }
  .p-stitch > .wrap { padding-inline: 0; }
  .p-stitch .p-map { grid-column: 1 / 8; }
  .p-stitch .p-text { grid-column: 8 / 13; }
  :global(.p-bleed) { display: block; }
  .p-map { margin: 0; }
  :global(.p-bleed img) { width: 100%; height: auto; }
  .p-map .cap { margin-top: var(--s3); color: var(--dim); max-width: 64ch; }
  .p-stitch .p-text { margin-top: 0; max-width: 36em; }


  /* design-team work: the team named once, its tasks under it */
  .team { display: grid; gap: var(--s7); }
  .team-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s2) var(--s4); margin: 0; padding-top: var(--s5); border-top: 1px solid var(--line);
    font-size: 15px; font-weight: 500; }
  .team-head .dim { font-weight: 400; color: var(--dim); }
  .status :global(.badge) { margin-right: 8px; }
  .tasks { list-style: none; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s7) var(--gap); }
  .task { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); gap: var(--s5); align-items: start; }
  .task-fig { display: block; width: 100%; height: auto; }
  .task-text { display: grid; gap: var(--s3); align-content: start; }
  .task-text h3 { font-size: var(--t-h3); line-height: 1.15; }
  .task-text .small { color: var(--dim); }

  /* earlier work */
  .earlier { padding-block: var(--s9); border-top: 1px solid var(--line); }
  .earlier h2 { font-size: var(--t-h3); margin-bottom: var(--s7); }
  .earlier ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s7) var(--gap); }
  .earlier li { display: grid; gap: var(--s2); align-content: start; max-width: 34em; }
  .earlier h3 { font-size: 18px; }

  /* contact: its own band, lit from below like the sky at the top */
  .contact { position: relative; overflow: hidden; border-top: 1px solid var(--line);
    background: radial-gradient(90% 120% at 80% 140%, var(--glow), var(--deep) 50%, var(--black) 90%); }
  .c-inner { padding-block: var(--s9); row-gap: var(--s7); align-items: start; }
  .c-side { grid-column: 1 / 5; display: grid; gap: var(--s4); }
  .c-side h2 { font-size: var(--t-h2); line-height: 1.05; }
  .c-main { grid-column: 5 / 13; display: grid; gap: var(--s3); min-width: 0; }
  .c-mail { display: grid; gap: var(--s3); justify-items: start; text-decoration: none; width: fit-content; max-width: 100%; }
  .c-addr { font-weight: 500; letter-spacing: -0.01em; font-size: clamp(20px, 2.8vw, 42px); line-height: 1.15; white-space: nowrap;
    text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.16em; text-decoration-color: rgb(243 245 255 / 0.4); transition: text-decoration-color 160ms ease; }
  .c-mail:hover .c-addr, .c-mail:focus-visible .c-addr { text-decoration-color: var(--white); }
  .c-mail:focus-visible { outline: 2px solid var(--white); outline-offset: 6px; }
  .c-hint { color: var(--dim); display: inline-grid; }
  .c-hint > span { grid-area: 1 / 1; display: inline-flex; align-items: center; gap: 8px; transition: opacity 160ms ease; }
  .c-hint-done { opacity: 0; color: var(--white); }
  .c-mail.copied .c-hint-copy { opacity: 0; }
  .c-mail.copied .c-hint-done { opacity: 1; }
  .c-alt { color: var(--dim); }
  .c-links { list-style: none; margin: var(--s6) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s3); }
  .c-links a { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: var(--s4); row-gap: 2px; align-items: center;
    padding: var(--s4) var(--s5); border: 1px solid var(--line); border-radius: 10px; text-decoration: none; background: rgb(1 3 10 / 0.35);
    transition: border-color 160ms ease, background-color 160ms ease; }
  .c-links a:hover { border-color: rgb(243 245 255 / 0.5); background: rgb(1 3 10 / 0.6); }
  .c-links a:focus-visible { outline: 2px solid var(--white); outline-offset: 3px; }
  .c-links a:active { background: rgb(243 245 255 / 0.08); }
  .c-links :global(.c-ico) { grid-row: 1 / 3; width: 26px; height: 26px; }
  .c-name { font-weight: 500; }
  .c-sub { color: var(--dim); overflow-wrap: anywhere; }

  @media (max-width: 759px) {
    .hero { height: auto; min-height: 0; background: none; overflow: visible; }
    .hero::after { display: none; }
    .sky { position: relative; height: min(70svh, 520px); overflow: hidden;
      background: radial-gradient(140% 90% at 30% 120%, var(--glow), var(--deep) 45%, var(--black) 85%); }
    .who { position: relative; left: auto; right: auto; bottom: auto; margin-top: -56px; padding: 0 var(--edge); }
    .who h1 { font-size: clamp(22px, 7.6vw, 44px); margin-bottom: var(--s4); }
    .intro { padding-block: var(--s7); row-gap: var(--s5); }
    :global(.portrait) { grid-column: 1 / 9; }
    .intro { align-items: start; }
    .intro-text { grid-column: 1 / 13; }
    .work { gap: var(--s8); padding-bottom: var(--s8); }
    .earlier { padding-block: var(--s7); }
    .earlier h2 { margin-bottom: var(--s5); }
    .p-andon .p-text, .p-media { grid-column: 1 / 13; }
    .p-media { margin-top: var(--s5); }
    .p-stitch .p-map, .p-stitch .p-text { grid-column: 1 / -1; }
    /* phones: show a third of the mission larger, so the markers read as shapes */
    .p-stitch .p-text { margin-top: var(--s5); }
    .earlier ul { grid-template-columns: 1fr; }
    .tasks { grid-template-columns: 1fr; }
    .task { grid-template-columns: 1fr; }
    .task-fig { max-width: 240px; }
    .c-inner { padding-block: var(--s8); row-gap: var(--s5); }
    .c-side, .c-main { grid-column: 1 / -1; }
    .c-addr { font-size: clamp(17px, 5.2vw, 28px); white-space: normal; overflow-wrap: anywhere; }
    .c-links { grid-template-columns: 1fr; margin-top: var(--s5); }
  }
</style>
