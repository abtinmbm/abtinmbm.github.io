---
import Base from '../layouts/Base.astro';
import Win from '../components/Win.astro';
---
<Base title="Page not found | Abtin Aryanpour" description="This page doesn't exist.">
  <Win title="404 — Page not found" name="Page not found" class="lost" inClass="lost-text" labelledby="lost-heading">
      <h1 id="lost-heading" class="display">Page not found</h1>
      <p class="lead">The page may have moved, or the address may have a typo.</p>
      <ul>
        <li><a class="btn go" href="/">Return to desktop</a></li>
        <li><a class="btn" href="/#work">See the projects</a></li>
      </ul>
      <p><a href="mailto:aryanpourabtin@gmail.com">Email me about a broken link</a></p>
  </Win>
</Base>

<style>
  .lost { max-width: 46rem; }
  .lost :global(.lost-text) { display: grid; gap: var(--s5); padding-block: var(--s6); }
  h1 { font-size: var(--t-h2); line-height: 1.05; }
  .lead { font-size: var(--t-lead); line-height: 1.4; max-width: 30em; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s3); }
</style>
