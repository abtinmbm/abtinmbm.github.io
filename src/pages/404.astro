---
import Base from '../layouts/Base.astro';
import ProjectTrail from '../components/ProjectTrail.astro';
---
<Base title="Page not found | Abtin Aryanpour" description="This page doesn't exist.">
  <section class="lost">
    <div class="lost-sky"><ProjectTrail /></div>
    <div class="lost-text wrap">
      <h1 class="display">Page not found</h1>
      <p class="lead">No trail starts at this address. The page may have moved, or the link has a typo.</p>
      <ul>
        <li><a href="/">Go to the homepage</a></li>
        <li><a href="/#work">See the projects</a></li>
        <li><a href="mailto:aaryanpo@uwaterloo.ca">Email me about a broken link</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .lost { position: relative; min-height: min(78svh, calc(100svh - 200px)); display: grid; align-items: end; overflow: hidden;
    background: radial-gradient(110% 80% at 20% 130%, var(--glow), var(--deep) 45%, var(--black) 85%); }
  .lost-sky { position: absolute; inset: 0; }
  .lost::after { content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, rgb(1 3 10 / 0.9) 0%, rgb(1 3 10 / 0.6) 40%, transparent 75%); }
  .lost-text { position: relative; z-index: 1; display: grid; gap: var(--s5); padding-block: var(--s10) var(--s9); }
  h1 { font-size: var(--t-h2); line-height: 1.05; }
  .lead { font-size: var(--t-lead); line-height: 1.4; max-width: 30em; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s3); }
</style>
