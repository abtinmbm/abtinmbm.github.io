---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Bars from '../../components/Bars.astro';
import specNormal from '../../assets/andon/spec-normal.webp';
import specFault from '../../assets/andon/spec-fault.webp';
import rigTop from '../../assets/andon/rig-top.webp';
import faultObstruction from '../../assets/andon/fault-obstruction.webp';
import AucChart from '../../components/AucChart.astro';
import AndonReplay from '../../components/AndonReplay.astro';
import Icon from '../../components/Icon.astro';
import AndonPipeline from '../../components/AndonPipeline.astro';
import AndonWiring from '../../components/AndonWiring.astro';
import { andon } from '../../data/metrics';
import { projects } from '../../data/projects';
import '../../styles/project.css';

const p = projects.find((x) => x.slug === 'andon')!;
const num = (s: string) => Number(s.replace('%', ''));
const stack = 'Python, PyTorch, scikit-learn, Streamlit, C and the Pico SDK.';
const clips = [
  { img: specNormal, name: 'Normal', audio: '/audio/fan-normal.mp3', alt: 'Spectrogram of a normal clip: steady bright bands in the low frequencies.' },
  { img: specFault, name: 'Faulty', audio: '/audio/fan-fault.mp3', alt: 'Spectrogram of a faulty clip from the same fan: the bands look almost the same.' },
];
---
<Base
  title="Andon: hearing when a machine sounds wrong | Abtin Aryanpour"
  description="A machine-sound anomaly detector that learns only from healthy recordings and turns a green, yellow or red light when a machine starts to sound wrong."
  current="projects"
  project="andon"
>
  <article class="proj">
    <header class="top tile" data-win="Andon" id="top-win">
      <div class="tb"><span class="t">andon — readme</span><button type="button" class="wbtn" data-min aria-expanded="true" aria-label="Minimize Andon"><i></i></button></div>
      <div class="top-in in">
        <h1 class="display">Andon</h1>
        <p class="lead">A machine-sound anomaly detector that learns only from healthy recordings, and turns a green, yellow or red light when a machine starts to sound wrong.</p>
        <div class="key-stack">
          <p class="key"><span class="key-n">{andon.meanAuc}</span><span class="key-l">AUC on held-out test recordings, scored once, where 50% is a coin flip. The challenge’s own baseline scores <b>{andon.baselineAuc}</b>.</span></p>
          <p class="key key-sm"><span class="key-n">{andon.jidokaFans}</span><span class="key-l">real fans stopped by the Pico 2 by itself, <span class="nw">{andon.jidokaRange}</span> after a fault (one trial per fan).</span></p>
        </div>
        <dl class="facts">
          <div><dt>Status</dt><dd>In progress since October 2026. The software is done, and on a Raspberry Pi Pico 2 it now hears a fault in a real fan and cuts the fan’s power by itself.</dd></div>
          <div><dt>Role</dt><dd>Solo project. I designed and built all of it.</dd></div>
          <div><dt>Code</dt><dd><a class="code-link" href={p.repo}><Icon name="github" /> Andon on GitHub</a></dd></div>
        </dl>
        <nav class="toc" aria-label="On this page"><span>On this page</span><a href="#how">How it works</a><a href="#data">The data</a><a href="#results">Results</a><a href="#hard">What was hard</a><a href="#hardware">Hardware</a><a href="#limits">Limits</a><a href="#next">Next</a></nav>
      </div>
    </header>

    <section class="part tile first" aria-labelledby="why-h" data-win="Overview">
      <div class="tb"><span class="t">// 01 · overview</span><button type="button" class="wbtn" data-min aria-expanded="true" aria-label="Minimize Overview"><i></i></button></div>
      <div class="in col">
      <h2 id="why-h" class="visually-hidden">Why it exists</h2>
      <p class="intro">Factories use andon lights to flag a problem on the line. But machine faults are rare and expensive to record, so the system has to learn from normal sound alone.</p>
      <p>A small convolutional neural network (CNN), a common kind of model for images and sound, learns to recognize each individual machine by its sound. When it can no longer tell which machine it’s hearing, something has changed.</p>
      <div class="fig wide">
        <AndonReplay captionId="replay-cap">
          <figcaption id="replay-cap" class="small">The real scores from one fan (machine id_06, development test clips, first training run). Watch at 8× speed with sound off or listen at the original speed. The yellow light during normal running is a real warning that clears on its own. This fan was picked to show how the light works.</figcaption>
        </AndonReplay>
      </div>
      </div>
    </section>

    <section id="how" class="part tile" aria-labelledby="how-h" data-win="How it works" data-reveal>
      <div class="tb"><span class="t">// 02 · how it works</span><button type="button" class="wbtn" data-min aria-expanded="true" aria-label="Minimize How it works"><i></i></button></div>
      <div class="in col">
      <h2 id="how-h">From a sound to a light</h2>
      <div class="fig"><AndonPipeline /></div>
      <ol class="steps">
        <li><p><b>Listen.</b> Each 10-second clip becomes a log-mel spectrogram: how loud each of 128 frequency bands is, every 32 ms.</p></li>
        <li><p><b>Recognize.</b> One small CNN per machine type learns to tell that type’s machines apart, from normal recordings only.</p></li>
        <li><p><b>Score.</b> If the CNN can’t recognize the machine it’s hearing, the score rises. Each 2-second window gets a score, every second.</p></li>
        <li><p><b>Set limits.</b> Normal audio sets a warning limit and a control limit for each machine, like a factory control chart (the mean of normal scores plus 2 and 3 standard deviations). They’re the two dashed lines in the replay.</p></li>
        <li><p><b>Light.</b> Two windows in a row over the warning limit turn it yellow. Three in a row over the control limit turn it red, and it stays red until someone resets it.</p></li>
      </ol>
      </div>
    </section>

    <section id="data" class="part tile" aria-labelledby="data-h" data-win="The data" data-reveal>
      <div class="tb"><span class="t">// 03 · the data</span><button type="button" class="wbtn" data-min aria-expanded="true" aria-label="Minimize The data"><i></i></button></div>
      <div class="in col">
      <h2 id="data-h">The data and the model</h2>
      <dl class="defs">
        <div><dt>Where the sound came from</dt><dd><a href="https://dcase.community/documents/workshop2020/proceedings/DCASE2020Workshop_Koizumi_3.pdf">DCASE 2020 Task 2</a> is the machine-sound part of a public audio challenge (Detection and Classification of Acoustic Scenes and Events). It’s built from two public datasets: <a href="https://ieeexplore.ieee.org/document/8937164">ToyADMOS</a> (toy cars and conveyors) and <a href="https://dcase.community/documents/workshop2019/proceedings/DCASE2019Workshop_Purohit_21.pdf">MIMII</a> (real fans, pumps, slide rails and valves). The dataset authors recorded the machines and made the faults on purpose, for example with damaged parts, leaks, blockages or imbalance. Background noise recorded in real factories was mixed in, so the clips sound like a factory floor. The data is shared under CC BY-NC-SA 4.0. The real-fan recordings are my own, described under Hardware.</dd></div>
        <div><dt>How it’s split</dt><dd>Training uses only normal clips. The development test set mixes normal and faulty clips, and it’s where every choice was made. The evaluation set is other machines of the same types: the model learns their normal sound, but their test clips were scored once, at the end, so it’s the fairer test. There’s no separate validation set for the CNN. It trains for a fixed 100 epochs and keeps the last one.</dd></div>
        <div><dt>What kind of model it is</dt><dd>It isn’t regression, and it isn’t a hand-tuned filter. A fixed front end turns sound into 128 frequency bands every 32 ms. A CNN then learns, from those bands, to name which machine it’s hearing.</dd></div>
        <div><dt>What it outputs</dt><dd>A score, not a yes or no: how unsure the model is that it’s hearing the right machine. The light makes the yes or no from that score, using the control-chart limits and the 2-in-a-row and 3-in-a-row rules above.</dd></div>
      </dl>
      </div>
    </section>

    <section id="results" class="part tile" aria-labelledby="results-h" data-win="Results" data-reveal>
      <div class="tb"><span class="t">// 04 · results</span><button type="button" class="wbtn" data-min aria-expanded="true" aria-label="Minimize Results"><i></i></button></div>
      <div class="in col">
      <h2 id="results-h">Better than the DCASE baseline on five of six machine types</h2>
      <p>AUC is the chance a random faulty clip scores as more abnormal than a random normal one. 50% is guessing. The baseline is the official model released with the challenge, an autoencoder: it learns to rebuild normal sound and flags sound it can’t rebuild well. I re-implemented it and scored it the same way as my model.</p>
      <div class="fig wide"><AucChart /></div>
      <p><b class="num">{andon.meanAucSpread}</b> mean AUC on the held-out evaluation set, against {andon.baselineAucSpread} for the DCASE baseline, scored the same way. The mean is over 3 training runs, each started from a different random seed.</p>
      <p>Before changing anything I reproduced the published baseline on the development set, to within <b class="num">{andon.reproductionGap}</b> AUC points on all six machine types.</p>
      <p>Loudness alone isn’t enough on the benchmark. A sound-level meter for each machine averages <b class="num">{andon.levelDcaseMean}</b> AUC on the development set, against {andon.gmmDevAuc} for a Gaussian mixture for each machine and {andon.cnnDevAuc} for my CNN. It’s near chance on toy cars ({andon.levelToyCar}), toy conveyors ({andon.levelToyConveyor}) and valves ({andon.levelValve}).</p>
      <p>Played back as a continuous stream of test audio, the light caught <b class="num">{andon.faultsCaught}</b> of 30-second faults, on average {andon.secondsToRed} after they started, with {andon.falseAlarmsPerHour} false alarms per hour.</p>
      <p>It has {andon.weights} weights. Stored as 8-bit integers (int8), it’s <b class="num">{andon.int8Size}</b>, down from {andon.floatSize}, and still scores {andon.int8Auc} AUC. That’s small enough to fit on a microcontroller.</p>
      <p class="aside">The <a href="https://github.com/abtinmbm/andon/releases/tag/checkpoints-v1">trained checkpoints are public</a>, and <a href="https://github.com/abtinmbm/andon#reproduce-the-headline-number">two commands in the README</a> re-check the held-out CNN AUC results from a fresh clone.</p>
      </div>
    </section>

    <section id="hard" class="part tile" aria-labelledby="hard-h" data-win="What was hard" data-reveal>
      <div class="tb"><span class="t">// 05 · what was hard</span><button type="button" class="wbtn" data-min aria-expanded="true" aria-label="Minimize What was hard"><i></i></button></div>
      <div class="in col">
      <h2 id="hard-h">What was hard</h2>

      <h3>There were no faults to train on</h3>
      <p>Instead of learning what a fault sounds like, the CNN learns to name which machine it hears. Low confidence in the right name becomes the anomaly score. On the evaluation set, valve went from {andon.valveAe} AUC with the baseline to {andon.valveCnn}.</p>
      <figure class="specs duo wide">
        {clips.map((c) => (
          <div class="spec" data-listen>
            <div class="spec-img">
              <Picture src={c.img} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 939]} sizes="(max-width: 599px) 92vw, 34rem" alt={c.alt} />
              <i class="spec-head" aria-hidden="true"></i>
            </div>
            <div class="spec-bar">
              <span class="small">{c.name}</span>
              <button type="button" class="spec-play" hidden aria-label={`Listen to the ${c.name.toLowerCase()} clip, 10 seconds`}><span class="spec-ico" aria-hidden="true"></span><span class="spec-word">Listen</span></button>
            </div>
            <audio preload="none" src={c.audio}></audio>
          </div>
        ))}
        <figcaption class="small">Two 10&nbsp;s clips from the replay fan (id_06), as the model hears them: 128 frequency bands, low pitches at the bottom. The fault is hard to see and hard to hear, and training only ever hears the first kind. Audio: <a href="https://zenodo.org/records/3678171">DCASE 2020 Task 2 development data</a> (MIMII), CC BY-NC-SA 4.0, converted to MP3.</figcaption>
      </figure>

      <h3>Overconfidence hurt the score</h3>
      <p>Without mixup, the ToyConveyor classifier hit 100% training accuracy, which likely left little room for a fault to lower its confidence. Blending pairs of training examples (mixup) raised mean development AUC from {andon.devAucNoMixup} to {andon.devAucMixup}.</p>
      <div class="fig">
        <Bars min={50} max={100} ticks={[50, 75, 100]} unit="%" caption="Mean AUC on the development set. 50% is guessing."
          rows={[{ label: 'No mixup', to: num(andon.devAucNoMixup), text: andon.devAucNoMixup }, { label: 'Mixup', to: num(andon.devAucMixup), text: andon.devAucMixup, strong: true }]} />
      </div>

      <h3>PyTorch doesn’t say how it rounds</h3>
      <p>Its quantized kernels don’t specify their rounding, and a C port has to match them exactly. So I wrote a NumPy fixed-point reference of {andon.quantRefLines} lines that defines every integer step, and exports test vectors the C version must match.</p>
      </div>
    </section>

    <section id="hardware" class="part tile" aria-labelledby="hw-h" data-win="Hardware" data-reveal>
      <div class="tb"><span class="t">// 06 · hardware</span><button type="button" class="wbtn" data-min aria-expanded="true" aria-label="Minimize Hardware"><i></i></button></div>
      <div class="in col">
      <h2 id="hw-h">The hardware so far</h2>
      <p>The board now does the whole job by itself: it listens to a real fan, scores the sound, and cuts the fan’s power when the sound goes wrong. So far that’s been tried once on each fan.</p>
      <figure class="wide">
        <Picture src={rigTop} formats={['avif', 'webp']} fallbackFormat="webp" widths={[800, 1400, 1800]} sizes="(max-width: 1160px) 100vw, 70rem" alt="A wooden plank seen from above, holding a breadboard. A green Raspberry Pi Pico 2 is at the left, green, yellow and red LEDs run along the top, a push button sits in the middle, a MOSFET and a small microphone board are near the right, and a black 40 mm fan stands at the far right end." />
        <figcaption class="small">The whole rig on one plank: Pico 2, LEDs, button, MOSFET, microphone and fan.</figcaption>
      </figure>
      <dl class="defs">
        <div><dt>Andon light</dt><dd>Real green, yellow and red LEDs and a reset button on the Pico 2. The detector’s scores drive the light. Red cuts the fan, and only the button clears it.</dd></div>
        <div><dt>Kill switch</dt><dd>A MOSFET cuts the fan’s power, and the blades coast to a stop. On the board, <b class="num">{andon.killSwitchTrials}</b> fan-off trials passed. The worst PC round trip, from sending the command to the Pico’s reply, was {andon.killSwitchWorstRtt} against a {andon.killSwitchLimit} limit.</dd></div>
        <div><dt>Microphone</dt><dd>A digital microphone read by the Pico. A 1 kHz test tone measured {andon.micToneHz}.</dd></div>
      </dl>
      <figure class="wiring">
        <AndonWiring />
        <figcaption class="small">The circuit, drawn from the pin list in the firmware. The PC powers the Pico over USB, and only one fan is wired at a time.</figcaption>
      </figure>

      <h3>The real-fan recordings</h3>
      <p>The first session was recorded at home. A model can learn the room instead of the fault: the background, the desk and the echoes. So every session used for training or evaluation is now recorded in one room, the one where the device will be calibrated and demonstrated. The home session is kept on disk, but it’s never used for training or scoring.</p>
      <p>There are three sessions, each on a different day: d1 and d2 for development, where I make every choice, and d3, held back and scored once at the end. In each session, every one of the {andon.fans} fans gets about {andon.normalMinutes} of normal running ({andon.normalClips} clips of {andon.clipSeconds}) and {andon.faultMinutes} of each of {andon.faultTypes} faults ({andon.faultClips} clips each), recorded in takes: one unbroken recording of one fan in one condition. The normal running includes a control take: the fan is taken off its mount, put back and recorded running normally, so that just handling the fan isn’t mistaken for a fault.</p>

      <dl class="defs">
        <div><dt>Faults</dt><dd>Underspeed isn’t a change to the fan. It’s a speed setting. The fan’s power is switched on and off {andon.pwmKhz} times a second (pulse-width modulation, or PWM), and for underspeed it’s on {andon.underspeedDuty} of the time instead of all of it, so the fan runs slower, like a worn motor or a weak power supply. The fan takes a while to slow down, so the first {andon.underspeedSkip} of each underspeed recording is never used. Obstruction is a card strip over the bottom third of the intake. A third fault, a piece of tape on one blade, was dropped during d1 because it changed the sound by a different amount each time.</dd></div>
      </dl>
      <figure class="fig fault-photo">
        <Picture src={faultObstruction} formats={['avif', 'webp']} fallbackFormat="webp" widths={[500, 900]} sizes="(max-width: 599px) 92vw, 22rem" alt="A black 40 mm fan seen at an angle, with a strip of card taped across the bottom third of its open face and the small microphone board in front of it." />
        <figcaption class="small">Obstruction. The card strip runs across the bottom third of the fan, with the microphone in front. Underspeed has nothing to photograph: the fan looks the same, and only its speed setting changes.</figcaption>
      </figure>
      <p>All three sessions reached the PC with no breaks and no missing or corrupt audio, and a repeat check showed the underspeed fault changing the Sunon fan’s sound by a similar amount on each day.</p>
      <details class="more">
        <summary>Recording details: audio frames per session, the repeat check, and how much each fault changes the sound</summary>
        <dl class="defs">
        {andon.sessions.map((s) => (
          <div><dt>{s.name}, {s.date}</dt><dd>{s.takes} takes. The Pico sent <b class="num">{s.frames}</b> numbered, checked audio frames to the PC over USB (Universal Serial Bus), with {s.breaks} breaks, {s.missing} missing and {s.corrupt} corrupt. {s.note}</dd></div>
        ))}
        <div><dt>Repeat check</dt><dd>Before d2, I set a limit for the {andon.repeatFan}’s underspeed: in its most-changed band ({andon.repeatBand}), each later session had to land within {andon.repeatTolerance} of d1. It was {andon.repeatD1} in d1, {andon.repeatD2} in d2 ({andon.repeatDiff}) and {andon.repeatD3} in d3 ({andon.repeatDiffD3}), both inside the limit.</dd></div>
        </dl>
        <table class="facts-table hw-table">
        <caption>Sessions d1 / d2. The largest change in one frequency band against the same fan’s normal sound in the same session, averaged over each recording. Underspeed makes the fan quieter (negative dB) and obstruction makes it louder. These show that the faults change the sound. They are not detection results.</caption>
        <thead><tr><th scope="col">Fan</th><th scope="col">Underspeed</th><th scope="col">Obstruction</th></tr></thead>
        <tbody>
          {andon.bandChange.map((r) => (
            <tr><th scope="row">{r.fan}</th><td><span class="num">{r.under[0]} / {r.under[1]} dB</span> <span class="hw-band">({r.underBand})</span></td><td><span class="num">{r.obs[0]} / {r.obs[1]} dB</span> <span class="hw-band">({r.obsBand[0] === r.obsBand[1] ? r.obsBand[0] : r.obsBand.join(' / ')})</span></td></tr>
          ))}
        </tbody>
      </table>
      </details>

      <h3>A model for the real fans</h3>
      <p>The CNN from the first stage didn’t carry over. On the development sessions it rated the fault as more normal than normal running in {andon.cnnFailedCells} fan-and-fault cases. So the real fans use a simpler model, chosen on d1 and d2 by a rule I wrote down before any run.</p>
      <dl class="defs">
        <div><dt>Where the sound came from</dt><dd>The three sessions above, which I recorded through the Pico’s microphone in one room, with that room’s own background noise.</dd></div>
        <div><dt>How it’s split</dt><dd>The model learns each fan’s normal sound from d1 and d2 only, and never hears a fault while it learns. d3 was scored once, at the end. As on the device, the light’s limits come from the first {andon.limitMinutes} of the tested session’s normal running, and the light is judged on the rest.</dd></div>
        <div><dt>What kind of model it is</dt><dd>A Gaussian mixture model for each fan: a statistical description of that fan’s normal sound, fitted to the average of the 128 frequency bands over each 2-second window. It isn’t a CNN, regression or a hand-tuned filter.</dd></div>
        <div><dt>What it outputs</dt><dd>A score for each window: how unlikely its sound is for that fan when it runs normally. The light turns the scores into green, yellow or red with the same control-chart rules as above, and red cuts the fan.</dd></div>
      </dl>
      <p>On d3 it separated the faults from normal running in all {andon.realCells} fan-and-fault cases: <b class="num">{andon.realAuc}</b> AUC. With the light, {andon.realTakesCaught} fault recordings went red, with {andon.realFalseReds} false reds in {andon.realNormalTime} of normal running.</p>
      <p><b>A plain sound-level meter also gets {andon.realAuc} on these two faults</b>, because underspeed makes a fan quieter and the card makes it louder. So I checked whether the model hears more than volume, on the development sessions only: every test recording was set to the fan’s normal volume, which leaves a level meter nothing to go on. The model still caught every fault, <b class="num">{andon.levelMatchedAuc}</b> AUC on every fan and fault, so it hears the shape of the sound, not just how loud it is. That doesn’t show yet that it would catch a fault that’s quiet in real life.</p>

      <h3>Fast enough on the board</h3>
      <p>The microphone delivers sound in {andon.frameMs} frames, so the work for each frame has to finish before the next one arrives. My budget is under {andon.computeBudgetMs} per frame. The real fans’ Gaussian mixture runs in C on the Pico 2 (its RP2350 chip at 150 MHz, one of its two cores): turning the sound into frequency bands and scoring each window takes <b class="num">{andon.gmmMsPerFrame}</b> per frame. Fed recorded audio of each fan, the board’s scores match Python’s to {andon.gmmRelErr}, and the three fans’ models take {andon.gmmFlash} of flash.</p>
      <p>The benchmark’s int8 CNN also fits, at {andon.computeMsPerFrame} per frame, and matches Python bit for bit on the board.</p>

      <h3>Stopping the fan by itself</h3>
      <p>After a {andon.jidokaHoldoff} hold-off, the board fits each fan’s limits on its first {andon.limitMinutes} of running, then watches. In each trial, {andon.jidokaWatch} into the watch, a serial command switched the fan from full speed to {andon.underspeedDuty} (underspeed). Nothing else was sent and no button was pressed: the board went red on its own scores and cut the fan’s power.</p>
      <table class="facts-table">
        <caption>Time from the speed switch to the fan’s power being cut, on the board’s own clock. One trial per fan.</caption>
        <thead><tr><th scope="col">Fan</th><th scope="col">Switch to power cut</th></tr></thead>
        <tbody>
          {andon.jidokaStops.map((r) => <tr><th scope="row">{r.fan}</th><td class="num">{r.s}</td></tr>)}
        </tbody>
      </table>
      </div>
    </section>

    <section id="limits" class="part tile" aria-labelledby="short-h" data-win="Limits" data-reveal>
      <div class="tb"><span class="t">// 07 · limits</span><button type="button" class="wbtn" data-min aria-expanded="true" aria-label="Minimize Limits"><i></i></button></div>
      <div class="in col">
      <h2 id="short-h">Where it still falls short</h2>
      <p>AUC isn’t real-world performance. {andon.meanAuc} AUC still caught only {andon.faultsCaught} of faults on a continuous stream of test audio, and {andon.valveCaught} for valve. {andon.falseAlarmsPerHour} false alarms per hour is too many for a real line. A much simpler Gaussian mixture model, a classic statistical method, beats the CNN on {andon.gmmWins} machine types.</p>
      <p>On the real fans, both faults also change the loudness, so they’re easy faults. The same-volume check used the development sessions only, and it doesn’t show the model would catch a fault that’s quiet in real life. The board has stopped each fan only once so far, and its false-stop rate hasn’t been measured yet.</p>
      </div>
    </section>

    <section id="next" class="part tile" aria-labelledby="next-h" data-win="Next" data-reveal>
      <div class="tb"><span class="t">// 08 · next</span><button type="button" class="wbtn" data-min aria-expanded="true" aria-label="Minimize Next"><i></i></button></div>
      <div class="in col">
      <h2 id="next-h">What’s next</h2>
      <p class="intro">Measuring how reliably the board stops the fan.</p>
      <p>An hour of normal running to count false stops, then 10 trials of each fault and a demo video. The tape-on-a-blade imbalance fault, dropped from the dataset because it wasn’t consistent, comes back as an unseen test fault: judged against a control take and at matched volume, and reported on its own. The obstruction card can only be fitted with the fan off, so those trials fit the card, then start the fan, are timed from the fan starting, and are reported separately.</p>
      </div>
    </section>

    <nav class="onward tile" data-win="Next project" aria-label="Code and next project">
      <div class="tb"><span class="t">// end · code and next project</span><button type="button" class="wbtn" data-min aria-expanded="true" aria-label="Minimize Next project"><i></i></button></div>
      <div class="in">
      <p class="built">Built with {stack}</p>
      <a href={p.repo}><Icon name="github" /> Andon’s code on GitHub</a>
      <a href="/projects/dose-coach/">Next project: Dose Coach</a>
      </div>
    </nav>
  </article>
</Base>

<script>
  // Plays one clip at a time, with a line moving across its spectrogram.
  const specs = [...document.querySelectorAll<HTMLElement>('[data-listen]')];
  const stopAll = (except?: HTMLElement) => specs.forEach((s) => { if (s !== except) { const a = s.querySelector('audio')!; a.pause(); a.currentTime = 0; } });
  for (const spec of specs) {
    const btn = spec.querySelector<HTMLButtonElement>('.spec-play')!;
    const audio = spec.querySelector('audio')!;
    const head = spec.querySelector<HTMLElement>('.spec-head')!;
    const word = spec.querySelector<HTMLElement>('.spec-word')!;
    const name = spec.querySelector('.spec-bar .small')!.textContent!.toLowerCase();
    btn.hidden = false;
    let raf = 0;
    const tick = () => { head.style.left = `${(audio.currentTime / (audio.duration || 10)) * 100}%`; raf = requestAnimationFrame(tick); };
    const set = (on: boolean) => {
      spec.classList.toggle('playing', on); word.textContent = on ? 'Stop' : 'Listen';
      btn.setAttribute('aria-label', on ? `Stop the ${name} clip` : `Listen to the ${name} clip, 10 seconds`);
      if (on) tick(); else { cancelAnimationFrame(raf); head.style.left = '0%'; }
    };
    btn.addEventListener('click', () => { if (audio.paused) { stopAll(spec); audio.play(); } else { audio.pause(); audio.currentTime = 0; } });
    audio.addEventListener('play', () => set(true));
    audio.addEventListener('pause', () => set(false));
    audio.addEventListener('ended', () => { audio.currentTime = 0; set(false); });
  }
</script>

