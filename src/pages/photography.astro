---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import list from '../data/photos.json';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photography/*.webp', { eager: true });
const all = list.map((p) => ({ ...p, src: files[`../assets/photography/${p.file}`].default, a: p.w / p.h }));

// The order the photos are shown in. Numbers are positions in photos.json, counting from 1;
// photos of one subject or place sit together.
const order = [1, 2, 4, 3, 5, 6, 7, 8, 9, 10, 30, 11, 12, 13, 14, 47, 15, 16, 38, 40, 39, 41, 42, 45, 43, 44, 17, 22, 18, 19, 46, 20, 21, 25, 23, 24, 48, 49, 26, 27, 28, 29, 31, 32, 33, 34, 35, 36, 37];
if (new Set(order).size !== all.length || order.length !== all.length) throw new Error('photography: every photo must appear exactly once');
const photos = order.map((n) => all[n - 1]);
const total = photos.length;
---
<Base
  title="Photography | Abtin Aryanpour"
  current="photography"
  description="Photos by Abtin Aryanpour, taken on a Canon EOS 90D: cities at night, school sports, fire performers, mountains and a few cats."
>
  <header class="ph-head wrap">
    <h1 class="display">Photography</h1>
    <p class="lead">I take photos on a Canon EOS 90D, for school and for fun.</p>
  </header>

  <section class="viewer wrap" aria-label="Photos" data-viewer>
    <div class="track" tabindex="0" role="group" aria-label="Photo viewer. Use the arrow keys to move between photos.">
      {photos.map((p, k) => (
        <figure class="slide" id={`p${k + 1}`} aria-label={`Photo ${k + 1} of ${total}`}>
          <Picture src={p.src} alt={p.alt} formats={['avif', 'webp']} fallbackFormat="webp"
            widths={p.a > 2 ? [900, 1600, 2800] : [480, 800, 1200, 1600]}
            sizes={`(max-width: 759px) 100vw, min(92vw, ${Math.round(72 * p.a)}vh)`}
            loading={k === 0 ? 'eager' : 'lazy'} fetchpriority={k === 0 ? 'high' : undefined} />
        </figure>
      ))}
    </div>

    <div class="controls" hidden>
      <button type="button" class="step" data-step="-1" aria-label="Previous photo">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <p class="count num" aria-live="polite"><b>1</b> of {total}</p>
      <button type="button" class="step" data-step="1" aria-label="Next photo">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>

    <nav class="strip" aria-label="All photos">
      {photos.map((p, k) => (
        <a href={`#p${k + 1}`} class="thumb" aria-label={`Photo ${k + 1}`} aria-current={k === 0 ? 'true' : undefined} style={`--ta:${p.a.toFixed(3)}`}>
          <Picture src={p.src} alt="" formats={['avif', 'webp']} fallbackFormat="webp"
            widths={[Math.round(64 * p.a), Math.round(128 * p.a)]} sizes={`${Math.round(64 * p.a)}px`} loading="lazy" />
        </a>
      ))}
    </nav>
  </section>
</Base>

<style>
  .ph-head { padding-block: var(--page-top) var(--s6); display: grid; justify-items: center; text-align: center; gap: var(--s3); }
  h1 { font-size: var(--t-h2); line-height: 1; letter-spacing: 0.01em; }
  .lead { line-height: 1.4; color: var(--dim); }

  .viewer { --stage: clamp(320px, calc(100svh - 360px), 860px); padding-bottom: var(--page-end); scroll-margin-top: 16px; }
  /* One photo per screen width. Without JavaScript this still scrolls and snaps by swipe or trackpad. */
  .track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: 2px solid var(--white); outline-offset: 4px; }
  .slide { flex: 0 0 100%; height: var(--stage); margin: 0; display: grid; place-items: center; scroll-snap-align: center; scroll-snap-stop: always; }
  .slide :global(picture) { display: contents; }
  .slide :global(source) { display: none; }
  .slide :global(img) { display: block; max-width: 100%; max-height: var(--stage); width: auto; height: auto; }

  .controls { display: flex; justify-content: center; align-items: center; gap: var(--s5); margin-top: var(--s4); }
  .controls[hidden] { display: none; }
  .count { min-width: 6.5em; text-align: center; color: var(--dim); }
  .count b { color: var(--white); font-weight: 500; }
  .step { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid var(--line); border-radius: 50%; background: none; color: var(--white); cursor: pointer; transition: border-color 160ms ease, background-color 160ms ease; }
  .step svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .step:hover { border-color: var(--white); }
  .step:focus-visible { outline: 2px solid var(--white); outline-offset: 3px; }
  .step:active { background: rgb(243 245 255 / 0.12); }
  .step:disabled { opacity: 0.3; cursor: default; border-color: var(--line); }

  /* The film strip: every photo, the current one bright and outlined. */
  .strip { display: flex; justify-content: safe center; gap: 6px; margin-top: var(--s4); overflow-x: auto; padding: 4px 2px 8px; scrollbar-width: thin; scrollbar-color: var(--line) transparent; }
  .thumb { flex: 0 0 auto; display: block; height: 64px; aspect-ratio: var(--ta); opacity: 0.45; outline: 1px solid transparent; outline-offset: 2px; transition: opacity 160ms ease, outline-color 160ms ease; }
  .thumb :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .thumb:hover { opacity: 0.8; }
  .thumb:focus-visible { opacity: 1; outline: 2px solid var(--white); }
  .thumb[aria-current="true"] { opacity: 1; outline-color: var(--white); }

  @media (max-width: 759px) {
    .viewer { --stage: clamp(280px, calc(100svh - 360px), 560px); padding-inline: 0; }
    .controls, .strip { padding-inline: var(--edge); }
    .thumb { height: 48px; }
    /* On a phone the frame fits the current photo, so a panorama doesn't float in an empty box. */
    .track { align-items: flex-start; overflow-y: hidden; transition: height 200ms ease; }
    .slide { height: auto; }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-viewer]')) {
    const track = root.querySelector<HTMLElement>('.track')!;
    const slides = [...track.querySelectorAll<HTMLElement>('.slide')];
    const thumbs = [...root.querySelectorAll<HTMLAnchorElement>('.thumb')];
    const strip = root.querySelector<HTMLElement>('.strip')!;
    const controls = root.querySelector<HTMLElement>('.controls')!;
    const [prev, next] = root.querySelectorAll<HTMLButtonElement>('.step');
    const count = root.querySelector('.count b')!;
    const smooth = matchMedia('(prefers-reduced-motion: no-preference)').matches ? 'smooth' : 'auto';
    controls.hidden = false;
    let cur = 0;

    const phone = matchMedia('(max-width: 759px)');
    const fit = () => {
      const img = slides[cur].querySelector('img');
      track.style.height = phone.matches && img?.offsetHeight ? `${img.offsetHeight}px` : '';
    };
    for (const img of track.querySelectorAll('img')) img.addEventListener('load', fit);
    const show = (k: number, link = true) => {
      cur = k;
      fit();
      count.textContent = String(k + 1);
      prev.disabled = k === 0;
      next.disabled = k === slides.length - 1;
      thumbs.forEach((t, j) => (j === k ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      const t = thumbs[k];
      strip.scrollTo({ left: t.offsetLeft - strip.offsetLeft - (strip.clientWidth - t.offsetWidth) / 2, behavior: smooth });
      if (link) history.replaceState(null, '', `#p${k + 1}`);
    };
    const go = (k: number, behavior?: ScrollBehavior) => {
      k = Math.max(0, Math.min(slides.length - 1, k));
      // Step to a neighbour smoothly; jump straight to a photo further away.
      behavior ??= Math.abs(k - cur) === 1 ? smooth : 'auto';
      track.scrollTo({ left: slides[k].offsetLeft - track.offsetLeft, behavior });
      if (k !== cur) show(k);
    };

    // Swipes and trackpad scrolls land on a slide; keep the counter and strip in step.
    let timer = 0;
    track.addEventListener('scroll', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        const k = Math.round(track.scrollLeft / track.clientWidth);
        if (k !== cur) show(k);
      }, 80);
    }, { passive: true });

    prev.addEventListener('click', () => go(cur - 1));
    next.addEventListener('click', () => go(cur + 1));
    thumbs.forEach((t, j) => t.addEventListener('click', (e) => { e.preventDefault(); go(j); }));
    document.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      const map: Record<string, number> = { ArrowLeft: cur - 1, ArrowRight: cur + 1, Home: 0, End: slides.length - 1 };
      if (!(e.key in map)) return;
      if ((e.key === 'Home' || e.key === 'End') && !root.contains(document.activeElement)) return;
      e.preventDefault();
      go(map[e.key]);
    });

    // A link to #p12 opens on photo 12.
    const m = /^#p(\d+)$/.exec(location.hash);
    if (m) requestAnimationFrame(() => { go(Number(m[1]) - 1, 'auto'); window.scrollTo(0, 0); });
    else show(0, false);
    new ResizeObserver(() => { fit(); go(cur, 'auto'); }).observe(track);
  }
</script>
