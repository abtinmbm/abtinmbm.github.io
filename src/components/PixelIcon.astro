---
// 16×16 pixel icons for the desktop, the taskbar and the boot box. Drawn with theme colours.
type Name = 'monitor' | 'andon' | 'stitcher' | 'lloyd' | 'dose' | 'photos' | 'resume' | 'about';
interface Props { name: Name; class?: string; size?: number }
const { name, class: cls, size } = Astro.props;
const f = (c: string, d: string) => `<path fill="${c}" d="${d}"/>`;
const ink = 'var(--fg)', well = 'var(--well)', acc = 'var(--accent)';
const art: Record<Name, string> = {
  monitor: f(ink, 'M1 2h14v10H1z') + f(well, 'M2 3h12v8H2z') + f(acc, 'M3 4h4v1H3zM3 6h6v1H3zM3 8h3v1H3z') + f(ink, 'M6 12h4v2H6zM3 14h10v1H3z'),
  andon: f(ink, 'M5 1h6v12H5zM7 13h2v2H7zM4 15h8v1H4z') + f('var(--R)', 'M6 2h4v3H6z') + f('var(--Y)', 'M6 6h4v3H6z') + f('var(--G)', 'M6 10h4v2H6z'),
  stitcher: f(ink, 'M1 2h8v7H1zM7 7h8v7H7z') + f(well, 'M2 3h6v5H2zM8 8h6v5H8z') + f(acc, 'M8 8h1v1H8zM3 4h2v2H3zM10 10h2v2h-2z'),
  lloyd: f(ink, 'M1 1h14v14H1z') + f(well, 'M2 2h5v6H2zM8 2h6v4H8zM8 7h6v7H8zM2 9h5v5H2z') + f(acc, 'M4 4h2v2H4zM10 3h2v2h-2zM10 10h2v2h-2zM4 11h2v2H4z'),
  dose: f(ink, 'M1 5h2v6H1zM3 4h2v8H3zM5 7h6v2H5zM11 4h2v8h-2zM13 5h2v6h-2z') + f(acc, 'M7 7h2v2H7z'),
  photos: f(ink, 'M5 2h6v2h4v10H1V4h4z') + f(well, 'M2 5h12v8H2z') + f(ink, 'M6 6h4v1H6zM5 7h1v4H5zM10 7h1v4h-1zM6 11h4v1H6z') + f(acc, 'M7 8h2v2H7zM12 5h1v1h-1z'),
  resume: f(ink, 'M2 1h9v1H2zM2 1h1v14H2zM2 14h12v1H2zM13 4h1v11h-1zM10 1h1v3h3v1h-4z') + f(well, 'M3 2h7v3h3v9H3z') + f(ink, 'M4 6h7v1H4zM4 8h7v1H4zM4 10h5v1H4z') + f(acc, 'M4 12h4v1H4z'),
  about: f(ink, 'M5 1h6v1H5zM4 2h1v6H4zM11 2h1v6h-1zM5 8h6v1H5zM2 10h12v1H2zM1 11h1v4H1zM14 11h1v4h-1zM2 15h12v1H2z') + f(well, 'M5 2h6v6H5zM2 11h12v4H2z') + f(acc, 'M6 4h1v1H6zM9 4h1v1H9zM6 6h4v1H6z'),
};
---
<svg class:list={['px-icon', cls]} viewBox="0 0 16 16" width={size} height={size} shape-rendering="crispEdges" aria-hidden="true" focusable="false" set:html={art[name]} />
