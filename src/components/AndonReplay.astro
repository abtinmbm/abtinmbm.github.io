---
import trace from '../data/andon-replay.json';
import { chartSvg, redDelay, STATE_TEXT } from '../lib/replay';

interface Props { captionId: string; autoplay?: boolean; }
const { captionId, autoplay = true } = Astro.props;
const n = trace.t.length;
// First paint and the no-JS view show the finished replay.
const initial = chartSvg(trace, n, 880, 340);
const label = `Anomaly score over two and a half minutes of one fan's sound. During normal running it stays mostly under both limits. A few windows go over, which turns the light yellow briefly, but never three in a row over the control limit. After the fault starts it jumps above the control limit, and the light turns red ${redDelay(trace).toFixed(1)} seconds later.`;
---
<figure class="replay" data-replay data-autoplay={autoplay ? '' : undefined} aria-describedby={captionId}>
  <div class="rp-bar" hidden>
    <button type="button" class="btn sm rp-toggle">Play replay</button>
    <button type="button" class="btn sm rp-jump">Jump to fault</button>
    <button type="button" class="btn sm rp-sound" aria-pressed="false">Sound <span aria-hidden="true">off</span></button>
  </div>
  <div class="rp-stage">
    <div class="rp-light">
      <span class="rp-lamps" aria-hidden="true"><i data-l="R" class="on"></i><i data-l="Y"></i><i data-l="G"></i></span>
      <span class="rp-state">{STATE_TEXT.R}</span>
    </div>
    <svg class="rp-chart" viewBox="0 0 880 340" role="img" aria-label={label} set:html={initial} />
  </div>
  <div class="rp-controls" hidden>
    <div class="rp-scrub">
      <label for={`${captionId}-time`}>Replay time</label>
      <input id={`${captionId}-time`} type="range" min="0" max={trace.faultEnd} step="any" value={trace.faultEnd} />
      <span class="rp-now small dim num" aria-hidden="true"></span>
    </div>
    <details class="rp-credit">
      <summary>Recording source</summary>
      <p>Fan audio from the <a href="https://zenodo.org/records/3678171">DCASE 2020 Task 2 development set</a> (Koizumi et al., MIMII recordings by Purohit et al.). Clips joined, padded and encoded as MP3 under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>.</p>
    </details>
    <span class="visually-hidden rp-message" role="status"></span>
    <audio src="/audio/andon-fan-replay.mp3" preload="none" muted></audio>
  </div>
  <slot />
</figure>

<style is:global>
  .replay { margin: 0; }
  .rp-stage { box-shadow: var(--bevel-in); background: var(--well); padding: 2px; }
  .rp-light { display: flex; align-items: center; gap: 14px; padding: 10px 12px; }
  .rp-lamps { display: flex; gap: 4px; }
  .rp-lamps i { width: 30px; height: 14px; background: var(--lamp-off); box-shadow: inset 1px 1px 0 var(--lo2), inset -1px -1px 0 var(--hi); }
  .rp-lamps i.on[data-l="R"] { background: var(--R); }
  .rp-lamps i.on[data-l="Y"] { background: var(--Y); }
  .rp-lamps i.on[data-l="G"] { background: var(--G); }
  .rp-state { font: 400 15px var(--mono); }
  .rp-chart { display: block; width: 100%; height: auto; overflow: visible; padding: 4px 12px 12px; box-sizing: border-box; }
  .rp-grid { stroke: var(--rule); stroke-width: 1; }
  .rp-tick { font: 400 11px var(--mono); fill: var(--mute); font-variant-numeric: tabular-nums; }
  .rp-note { font: 400 11px var(--mono); fill: var(--mute); }
  .rp-strong { fill: var(--accent); }
  .rp-limit { stroke-width: 1.4; stroke-dasharray: 6 5; }
  .rp-fault { stroke: var(--fg); stroke-opacity: 0.55; stroke-width: 1; stroke-dasharray: 2 4; }
  .rp-ghost { fill: none; stroke: var(--fg); stroke-opacity: 0.16; stroke-width: 1.2; stroke-linejoin: round; }
  .rp-score { fill: none; stroke: var(--fg); stroke-width: 1.6; stroke-linejoin: round; }
  .rp-controls { display: grid; gap: 9px; margin-top: 12px; }
  .rp-controls[hidden], .rp-bar[hidden] { display: none; }
  .rp-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 10px; }
  .rp-sound { gap: 5px; }
  .rp-scrub { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; }
  .rp-scrub label { font-size: 13px; }
  .rp-scrub input { margin: 0; flex: 1 1 6rem; min-width: 0; accent-color: var(--accent); }
  .rp-now { font: 400 12px var(--mono); color: var(--mute); }
  .rp-credit { color: var(--mute); font-size: 12.5px; }
  .rp-credit summary { cursor: pointer; }
  .replay figcaption { margin-top: 10px; color: var(--mute); font-size: 13.5px; line-height: 1.45; max-width: 70ch; }
</style>

<script>
  import { chartSvg, STATE_TEXT, type Trace } from '../lib/replay';
  import data from '../data/andon-replay.json';

  const tr = data as Trace;
  const N = tr.t.length;
  const end = tr.faultEnd;
  const beforeFault = Math.max(0, tr.faultStart - 5);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const fig of document.querySelectorAll<HTMLElement>('[data-replay]')) {
    const svg = fig.querySelector('svg')!;
    const lamps = [...fig.querySelectorAll<HTMLElement>('.rp-lamps i')];
    const state = fig.querySelector<HTMLElement>('.rp-state')!;
    const now = fig.querySelector<HTMLElement>('.rp-now')!;
    const btn = fig.querySelector<HTMLButtonElement>('.rp-toggle')!;
    const soundBtn = fig.querySelector<HTMLButtonElement>('.rp-sound')!;
    const soundLabel = soundBtn.querySelector('span')!;
    const range = fig.querySelector<HTMLInputElement>('input')!;
    const audio = fig.querySelector<HTMLAudioElement>('audio')!;
    const message = fig.querySelector<HTMLElement>('.rp-message')!;
    let time = end, timer = 0, visible = false, wanted = fig.hasAttribute('data-autoplay') && !reduce;
    let sound = false, hold = 0, scrubbing = false;
    let pendingSeek: number | null = null;

    const render = () => {
      const W = Math.round(svg.clientWidth) || 880;
      const H = W < 520 ? Math.round(W * 0.78) : Math.round(Math.min(380, Math.max(300, W * 0.4)));
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const next = tr.t.findIndex((point) => point > time);
      const n = next === -1 ? N : next;
      svg.innerHTML = chartSvg(tr, n, W, H);
      const l = (n ? tr.light[n - 1] : 'G') as keyof typeof STATE_TEXT;
      lamps.forEach((i) => i.classList.toggle('on', i.dataset.l === l));
      state.textContent = STATE_TEXT[l];
      const elapsed = `${time.toFixed(1)} s of ${end.toFixed(0)} s`;
      if (!scrubbing) range.valueAsNumber = time;
      range.setAttribute('aria-valuetext', `${elapsed}, ${STATE_TEXT[l]}`);
      now.textContent = `${elapsed} · ${sound ? '1×' : '8×'}`;
    };
    const setSound = (on: boolean) => {
      sound = on;
      audio.muted = !on;
      soundBtn.setAttribute('aria-pressed', String(on));
      soundLabel.textContent = on ? 'on' : 'off';
    };
    const readAudioTime = () => {
      if (pendingSeek === null && !audio.seeking) time = Math.min(end, audio.currentTime);
    };
    const tick = () => {
      if (sound) readAudioTime();
      else if (time < end) time = Math.min(end, time + 1);
      else if (++hold > 24) { time = 0; hold = 0; }
      render();
    };
    const sync = () => {
      const run = wanted && visible;
      if (run && !timer) timer = window.setInterval(tick, 125);
      if (!run && timer) { clearInterval(timer); timer = 0; }
      btn.textContent = wanted ? 'Pause replay' : 'Play replay';
    };
    const pause = () => {
      if (sound && !audio.ended) readAudioTime();
      wanted = false;
      audio.pause();
      sync();
      render();
    };
    const seekAudio = () => {
      if (Math.abs(audio.currentTime - time) < 0.01 && !audio.seeking) return;
      pendingSeek = time;
      audio.currentTime = time;
    };
    const seek = (position: number) => {
      time = position;
      hold = 0;
      if (sound) seekAudio();
      render();
    };
    const playAudio = async () => {
      message.textContent = '';
      seekAudio();
      try { await audio.play(); }
      catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        setSound(false);
        pendingSeek = null;
        pause();
        message.textContent = 'The fan recording could not play.';
      }
    };

    fig.querySelector<HTMLElement>('.rp-controls')!.hidden = false;
    fig.querySelector<HTMLElement>('.rp-bar')!.hidden = false;
    btn.addEventListener('click', () => {
      if (wanted) { pause(); return; }
      if (time >= end) seek(0);
      wanted = true;
      sync();
      if (sound) void playAudio();
    });
    fig.querySelector('.rp-jump')!.addEventListener('click', () => {
      if (!sound) pause();
      seek(beforeFault);
    });
    range.addEventListener('pointerdown', () => { scrubbing = true; });
    const endScrub = () => { if (scrubbing) { scrubbing = false; render(); } };
    window.addEventListener('pointerup', endScrub);
    window.addEventListener('pointercancel', endScrub);
    range.addEventListener('input', () => {
      if (!sound) { wanted = false; sync(); }
      seek(range.valueAsNumber);
    });
    soundBtn.addEventListener('click', () => {
      if (sound) {
        readAudioTime();
        setSound(false);
        audio.pause();
        pendingSeek = null;
        render();
        return;
      }
      if (time >= end) seek(beforeFault);
      wanted = true;
      setSound(true);
      sync();
      render();
      void playAudio();
    });
    audio.addEventListener('seeked', () => {
      if (pendingSeek !== null && Math.abs(audio.currentTime - pendingSeek) < 0.25) pendingSeek = null;
    });
    audio.addEventListener('ended', () => { time = end; pendingSeek = null; pause(); });
    audio.addEventListener('pause', () => { if (sound && wanted && audio.paused && !audio.ended) pause(); });
    audio.addEventListener('play', () => {
      for (const other of document.querySelectorAll('audio')) if (other !== audio) other.pause();
    });
    document.addEventListener('play', (event) => {
      if (sound && wanted && event.target instanceof HTMLMediaElement && event.target !== audio) pause();
    }, true);
    document.addEventListener('visibilitychange', () => { if (document.hidden && sound && wanted) pause(); });
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (!visible && sound && wanted) pause();
      if (visible && wanted && time >= end) seek(0);
      sync();
    }).observe(fig);
    let raf = 0;
    new ResizeObserver(() => { cancelAnimationFrame(raf); raf = requestAnimationFrame(render); }).observe(svg);
    render();
    sync();
  }
</script>
