---
import trace from '../data/andon-replay.json';
import { chartSvg, redDelay, STATE_TEXT } from '../lib/replay';

interface Props { captionId: string; }
const { captionId } = Astro.props;
const n = trace.t.length;
// First paint and the no-JS view show the finished replay.
const initial = chartSvg(trace, n, 880, 340);
const label = `Anomaly score over two and a half minutes of one fan's sound. During normal running it stays mostly under both limits. A few windows go over, which turns the light yellow briefly, but never three in a row over the control limit. After the fault starts it jumps above the control limit, and the light turns red ${redDelay(trace).toFixed(1)} seconds later.`;
---
<figure class="replay" data-replay aria-describedby={captionId}>
  <div class="rp-stage">
    <div class="rp-light">
      <span class="rp-lamps" aria-hidden="true"><i data-l="R" class="on"></i><i data-l="Y"></i><i data-l="G"></i></span>
      <span class="rp-state">{STATE_TEXT.R}</span>
    </div>
    <svg class="rp-chart" viewBox="0 0 880 340" role="img" aria-label={label} set:html={initial} />
  </div>
  <div class="rp-bar">
    <button type="button" class="rp-toggle" hidden>Play replay</button>
    <span class="rp-now small dim num" aria-hidden="true"></span>
  </div>
  <slot />
</figure>

<style is:global>
  .replay { margin: 0; }
  .replay { --rp-col: 128px; --rp-gap: 64px; }
  .rp-stage { display: grid; grid-template-columns: var(--rp-col) minmax(0, 1fr); gap: var(--rp-gap); align-items: center; }
  .rp-light { display: grid; justify-items: start; gap: var(--s4); }
  .rp-lamps { display: grid; gap: 10px; padding: 12px; border: 1px solid var(--line); border-radius: 40px; }
  .rp-lamps i { width: 34px; height: 34px; border-radius: 50%; background: rgb(243 245 255 / 0.07); }
  .rp-lamps i.on[data-l="R"] { background: #d62828; }
  .rp-lamps i.on[data-l="Y"] { background: #f2b705; }
  .rp-lamps i.on[data-l="G"] { background: #2e9d4f; }
  .rp-state { font-size: 14px; color: var(--dim); line-height: 1.3; min-height: 2.6em; }
  .rp-chart { display: block; width: 100%; height: auto; overflow: visible; }
  .rp-grid { stroke: var(--line); stroke-width: 1; }
  .rp-tick { font-size: 12px; fill: var(--dim); font-variant-numeric: tabular-nums; }
  .rp-note { font-size: 13px; fill: var(--dim); }
  .rp-strong { fill: var(--white); font-weight: 500; }
  .rp-limit { stroke-width: 1.4; stroke-dasharray: 6 5; }
  .rp-fault { stroke: var(--white); stroke-opacity: 0.55; stroke-width: 1; stroke-dasharray: 2 4; }
  .rp-score { fill: none; stroke: var(--white); stroke-width: 1.6; stroke-linejoin: round; }
  .rp-bar { display: flex; align-items: baseline; gap: var(--s5); margin-top: var(--s4); padding-left: calc(var(--rp-col) + var(--rp-gap)); min-height: 1.6em; }
  .rp-toggle { font: inherit; font-size: 15px; color: var(--white); background: none; border: 0; padding: 4px 0; cursor: pointer;
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.3em; }
  .rp-toggle:hover, .rp-toggle:focus-visible { text-decoration-thickness: 2px; }
  .replay figcaption { margin-top: var(--s3); padding-left: calc(var(--rp-col) + var(--rp-gap)); color: var(--dim); max-width: calc(64ch + var(--rp-col) + var(--rp-gap)); }
  @media (max-width: 599px) {
    .rp-stage { grid-template-columns: 1fr; gap: var(--s5); }
    .rp-light { grid-auto-flow: column; justify-content: start; align-items: center; }
    .rp-lamps { grid-auto-flow: column; padding: 8px; }
    .rp-lamps i { width: 26px; height: 26px; }
    .rp-state { min-height: 0; }
    .rp-bar, .replay figcaption { padding-left: 0; }
  }
</style>

<script>
  import { chartSvg, type Trace } from '../lib/replay';
  import data from '../data/andon-replay.json';
  import { STATE_TEXT } from '../lib/replay';

  const tr = data as Trace;
  const N = tr.t.length;
  const HOLD = 24; // windows' worth of pause on the final state, 3 s at 8 per second
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const fig of document.querySelectorAll<HTMLElement>('[data-replay]')) {
    const svg = fig.querySelector('svg')!;
    const lamps = [...fig.querySelectorAll<HTMLElement>('.rp-lamps i')];
    const state = fig.querySelector<HTMLElement>('.rp-state')!;
    const now = fig.querySelector<HTMLElement>('.rp-now')!;
    const btn = fig.querySelector<HTMLButtonElement>('.rp-toggle')!;
    let n = N, timer = 0, playing = false, visible = false, wanted = !reduce;

    const render = () => {
      const W = Math.round(svg.clientWidth) || 880;
      const H = W < 520 ? Math.round(W * 0.78) : Math.round(Math.min(380, Math.max(300, W * 0.4)));
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.innerHTML = chartSvg(tr, n, W, H);
      const l = (n ? tr.light[n - 1] : 'G') as keyof typeof STATE_TEXT;
      lamps.forEach((i) => i.classList.toggle('on', i.dataset.l === l));
      state.textContent = STATE_TEXT[l];
      now.textContent = `${(n ? tr.t[n - 1] : 0).toFixed(1)} s of ${tr.t[N - 1].toFixed(0)} s, at 8× speed`;
    };
    let hold = 0;
    const tick = () => {
      if (n < N) n++;
      else if (++hold > HOLD) { n = 1; hold = 0; }
      render();
    };
    const sync = () => {
      const run = wanted && visible;
      if (run && !playing) { if (n >= N) { n = 0; hold = 0; } timer = window.setInterval(tick, 125); playing = true; }
      if (!run && playing) { clearInterval(timer); playing = false; }
      btn.textContent = wanted ? 'Pause replay' : 'Play replay';
    };

    btn.hidden = false;
    btn.addEventListener('click', () => { wanted = !wanted; sync(); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: 0.35 }).observe(fig);
    let raf = 0;
    new ResizeObserver(() => { cancelAnimationFrame(raf); raf = requestAnimationFrame(render); }).observe(svg);
    render();
    sync();
  }
</script>
