---
// Dose Coach's circuit, drawn from the pin list at the top of ExerciseTracker/ExerciseTracker.ino and the
// README wiring table in github.com/abtinmbm/ece198 (read 2026-11-21 at f1c5d36). Change it if those change.
const gnd = (x: number, y: number) => `M${x - 10} ${y}h20M${x - 6.5} ${y + 5}h13M${x - 3} ${y + 10}h6`;
const pins = [
  [40, 'D2'], [76, 'D3'], [112, 'D4'], [172, 'D5'], [208, 'D7'], [258, 'D6'], [298, 'D8'],
  [362, 'A0'], [392, 'A1'], [422, 'A2'], [482, 'A4'], [512, 'A5'],
] as const;
const buttons = [{ y: 40, n: 'A' }, { y: 76, n: 'B' }, { y: 112, n: 'C' }];
const leds = [{ y: 172, c: 'var(--R)', name: 'Red' }, { y: 208, c: 'var(--Y)', name: 'Yellow' }];
const X = 345;
---
<svg class="dwiring" viewBox="0 0 440 540" role="img"
  aria-label="Circuit diagram. Arduino pins D2, D3 and D4 each go through a push button, A, B and C, to ground, using the board's built-in pull-up resistors. D5 drives a red LED and D7 a yellow LED, each through a 220 ohm resistor to ground. D6 reads the TAP pad touch sensor and D8 drives the buzzer. A0, A1 and A2 read the X, Y and Z outputs of the MMA7361 accelerometer, which runs from 5 volts with its sleep pin tied to its own 3.3 volt pin. A4 and A5 carry the I2C data and clock to the RGB LCD.">
  <rect class="block" x="0.5" y="10" width="96" height="520" />
  <text class="name" transform="translate(34 270) rotate(-90)" text-anchor="middle">Arduino UNO R4 Minima</text>
  {pins.map(([y, n]) => <text class="pin" x="90" y={y + 5} text-anchor="end">{n}</text>)}

  <text class="group" x="118" y="22">Buttons</text>
  {buttons.map(({ y, n }) => <>
    <path class="w" d={`M96 ${y}H250M290 ${y}H${X}M246 ${y - 10}H294M270 ${y - 10}V${y - 20}M262 ${y - 20}H278`} />
    <circle class="w bg" cx="250" cy={y} r="3" /><circle class="w bg" cx="290" cy={y} r="3" />
    <text class="pin" x={X + 13} y={y + 5}>{n}</text>
  </>)}
  <path class="w" d={`M${X} 40V124${gnd(X, 124)}`} />
  <circle class="dot" cx={X} cy="76" r="2.6" /><circle class="dot" cx={X} cy="112" r="2.6" />

  <text class="group" x="118" y="154">LEDs</text>
  <text class="val" x="235" y="154" text-anchor="middle">220 Ω each</text>
  {leds.map(({ y, c, name }) => <>
    <path class="w" d={`M96 ${y}H214M256 ${y}H286M304 ${y}H${X}`} />
    <rect class="r" x="214" y={y - 7} width="42" height="14" />
    <path d={`M286 ${y - 9}L304 ${y}L286 ${y + 9}Z`} fill={c} />
    <path class="w" d={`M304 ${y - 9}V${y + 9}`} />
    <text class="pin" x={X + 13} y={y + 5}>{name}</text>
  </>)}
  <path class="w" d={`M${X} 172V220${gnd(X, 220)}`} />
  <circle class="dot" cx={X} cy="208" r="2.6" />

  <path class="w" d="M96 258H230M96 298H230" />
  <rect class="block" x="230" y="244" width="110" height="28" />
  <text class="pin" x="285" y="263" text-anchor="middle">TAP pad</text>
  <rect class="block" x="230" y="284" width="110" height="28" />
  <text class="pin" x="285" y="303" text-anchor="middle">Buzzer</text>
  <text class="val" x="348" y="263">touch</text>

  <text class="group" x="118" y="346">Wrist sensor</text>
  <text class="val" x="230" y="340">MMA7361</text>
  <rect class="block" x="230" y="347" width="110" height="90" />
  <path class="w" d="M96 362H230M96 392H230M96 422H230" />
  <path class="fill" d="M163 362l9 -4.5v9zM163 392l9 -4.5v9zM163 422l9 -4.5v9z" />
  <text class="pin" x="238" y="367">X</text>
  <text class="pin" x="238" y="397">Y</text>
  <text class="pin" x="238" y="427">Z</text>
  <text class="pin" x="332" y="367" text-anchor="end">5V</text>
  <text class="pin" x="332" y="397" text-anchor="end">GND</text>
  <text class="pin" x="332" y="427" text-anchor="end">SL</text>
  <path class="w" d={`M340 362H364M340 392H372V400${gnd(372, 400)}M340 422H364`} />
  <text class="val" x="370" y="367">5 V</text>
  <text class="val" x="370" y="427">its 3.3 V</text>

  <text class="group" x="118" y="466">Screen</text>
  <text class="val" x="230" y="460">RGB LCD 16×2</text>
  <rect class="block" x="230" y="467" width="110" height="60" />
  <path class="w" d="M96 482H230M96 512H230" />
  <path class="fill" d="M172 482l-9 -4.5v9zM163 512l9 -4.5v9z" />
  <text class="pin" x="238" y="487">SDA</text>
  <text class="pin" x="238" y="517">SCL</text>
  <text class="val" x="348" y="502">I2C</text>
</svg>

<style>
  .dwiring { display: block; width: 100%; height: auto; overflow: visible; }
  .dwiring text { font-family: var(--text); fill: var(--white); }
  .w { fill: none; stroke: var(--white); stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; }
  .w.bg { fill: var(--black); }
  .r { fill: var(--black); stroke: var(--white); stroke-width: 1.25; }
  .block { fill: var(--tint); stroke: var(--white); stroke-width: 1.25; }
  .fill, .dot { fill: var(--white); }
  .dwiring .name { font-size: 18px; font-weight: 500; }
  .dwiring .group { font-size: 15px; font-weight: 500; }
  .dwiring .pin { font-size: 14.5px; font-variant-numeric: tabular-nums; }
  .dwiring .val { font-size: 13.5px; fill: var(--dim); }
</style>
