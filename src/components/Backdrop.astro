---
// A fixed star field behind every page. It turns slowly as the page scrolls,
// and holds still when the visitor prefers reduced motion.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);

// Stars spread over a square larger than any screen, so turning never shows an edge.
const stars: string[] = [];
for (let i = 0; i < 900; i++) {
  const x = (rnd() * 3000).toFixed(0), y = (rnd() * 3000).toFixed(0);
  const big = rnd() > 0.9;
  stars.push(`<circle cx="${x}" cy="${y}" r="${big ? 2.2 : 1.1}" fill="rgb(${rnd() > 0.7 ? '190 205 255' : '243 245 255'} / ${(big ? 0.85 : 0.3 + rnd() * 0.35).toFixed(2)})"/>`);
}
---
<div class="bd" aria-hidden="true"><svg viewBox="0 0 3000 3000" set:html={stars.join('')} /></div>

<script>
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const el = document.querySelector<SVGElement>('.bd svg');
    let raf = 0;
    if (el) addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => { el.style.transform = `rotate(${(scrollY * 0.006).toFixed(3)}deg)`; });
    }, { passive: true });
  }
</script>

<style is:global>
  body { background: transparent; position: relative; }
  body > main, body > footer { position: relative; z-index: 1; }
  .bd { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .bd svg { position: absolute; width: max(200vw, 200vh); height: max(200vw, 200vh); max-width: none;
    left: 50%; top: 50%; translate: -50% -50%; transform-origin: 50% 50%; will-change: transform; }
</style>
