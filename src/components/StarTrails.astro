---
import { layout, svgMarkup, type TrailProject } from '../lib/trails';

interface Props { projects: TrailProject[]; }
const { projects } = Astro.props;
// First paint (and the no-JS view) uses a desktop-sized sky drawn at build time.
// The script below redraws it for the real screen size, with today's date, and adds the labels.
const initial = svgMarkup(layout(projects, 1440, 900, new Date()));
---
<div class="sky-field" data-trails={JSON.stringify(projects)}>
  <svg class="sky-svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" set:html={initial} />
  <ul class="sky-labels" aria-label="Projects on the sky" hidden></ul>
</div>

<style is:global>
  .sky-field { position: absolute; inset: 0; }
  .sky-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .t-bg { fill: none; stroke: #dfe6ff; stroke-linecap: round; }
  .t-line { fill: none; stroke: var(--white); stroke-linecap: round; stroke-width: 2; stroke-opacity: 0.82; transition: stroke-width 160ms ease, stroke-opacity 160ms ease; }
  .t-proj.live .t-line { stroke-width: 2.4; stroke-opacity: 1; }
  .t-proj.on .t-line { stroke-width: 3.4; stroke-opacity: 1; }
  .t-head { fill: var(--white); }
  .t-halo { fill: url(#t-halo); }
  .sky-labels { list-style: none; margin: 0; padding: 0; }
  .sky-labels li { position: absolute; z-index: 2; transform: translate(16px, -50%); white-space: nowrap;
    text-shadow: 0 0 2px var(--black), 0 0 8px var(--black), 0 0 18px var(--black); }
  /* a soft dark patch behind each label, so trails never strike through its text */
  .sky-labels li::before { content: ""; position: absolute; inset: -4px -12px; z-index: -1; background: var(--black); opacity: 0.9; filter: blur(9px); border-radius: 12px; }
  .sky-labels li.left { transform: translate(calc(-100% - 16px), -50%); text-align: right; }
  .sky-labels a { display: block; text-decoration: none; padding: 4px 0; }
  .sky-labels .n { font-family: var(--display); font-weight: 500; font-size: 15px; letter-spacing: 0.005em;
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.3em; }
  .sky-labels a:hover .n, .sky-labels a:focus-visible .n { text-decoration-thickness: 2px; }
  .sky-labels .l { display: block; margin-top: 5px; font-size: 14px; color: var(--dim); }
  @media (max-width: 759px) {
    .sky-labels .l { display: none; }
    .sky-labels .n { font-size: 13px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .t-head.live { animation: t-breathe 3.2s ease-in-out 3; }
    @keyframes t-breathe { 50% { opacity: 0.5; } }
  }
</style>

<script>
  import { layout, svgMarkup, type TrailProject } from '../lib/trails';

  for (const field of document.querySelectorAll<HTMLElement>('[data-trails]')) {
    const projects: TrailProject[] = JSON.parse(field.dataset.trails!);
    const svg = field.querySelector('svg')!;
    const list = field.querySelector('ul')!;
    list.hidden = false;

    const draw = () => {
      const W = field.clientWidth, H = field.clientHeight;
      if (!W || !H) return;
      const L = layout(projects, W, H, new Date());
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.innerHTML = svgMarkup(L);
      list.replaceChildren();
      for (const t of L.trails) {
        if (!t.label) continue;
        const p = projects[t.i];
        const li = document.createElement('li');
        li.className = t.label.side;
        li.style.left = `${t.head.x}px`;
        li.style.top = `${t.head.y}px`;
        const a = document.createElement('a');
        a.href = p.link;
        a.innerHTML = `<span class="n"></span><span class="l"></span>`;
        a.querySelector('.n')!.textContent = p.name;
        a.querySelector('.l')!.textContent = p.line;
        const group = () => svg.querySelector(`.t-proj[data-i="${t.i}"]`);
        const on = () => group()?.classList.add('on');
        const off = () => group()?.classList.remove('on');
        a.addEventListener('pointerenter', on);
        a.addEventListener('pointerleave', off);
        a.addEventListener('focus', on);
        a.addEventListener('blur', off);
        li.append(a);
        list.append(li);
        // On phones every label sits left of its head; flip only one that would leave the screen.
        if (W < 760) {
          li.className = 'left';
          if (li.getBoundingClientRect().left < 12) li.className = 'right';
        }
      }
    };

    draw();
    let raf = 0;
    new ResizeObserver(() => { cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); }).observe(field);
  }
</script>
