---
import { layout, svgMarkup, bgMarkup, type TrailProject } from '../lib/trails';

interface Props { projects: TrailProject[]; }
const { projects } = Astro.props;
// First paint (and the no-JS view) uses a desktop-sized sky drawn at build time.
// The script below redraws it for the real screen size, with today's date, and adds the labels.
const L0 = layout(projects, 1440, 900, new Date());
---
<div class="sky-field" data-trails={JSON.stringify(projects)}>
  <svg class="sky-svg sky-bg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" set:html={bgMarkup(L0)} />
  <svg class="sky-svg sky-fg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" set:html={svgMarkup(L0)} />
  <ul class="sky-labels" aria-label="Projects on the sky" hidden></ul>
</div>
<script is:inline>
  // Set before first paint, so the sky starts empty and draws in instead of flashing complete.
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches) document.currentScript.previousElementSibling.classList.add('develop');
</script>

<style is:global>
  .sky-field { position: absolute; inset: 0; }
  .sky-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .t-bg { fill: none; stroke: #dfe6ff; stroke-linecap: round; }
  .t-line { fill: none; stroke: var(--white); stroke-linecap: round; stroke-width: 2; stroke-opacity: 0.82; transition: stroke-width 160ms ease, stroke-opacity 160ms ease; }
  .t-proj.live .t-line { stroke-width: 2.4; stroke-opacity: 1; }
  .t-proj.on .t-line { stroke-width: 3.4; stroke-opacity: 1; }
  .t-head { fill: var(--white); }
  .t-halo { fill: url(#t-halo); }
  .sky-labels { list-style: none; margin: 0; padding: 0; }
  .sky-labels li { position: absolute; z-index: 2; transform: translate(16px, -50%); white-space: nowrap;
    text-shadow: 0 0 2px var(--black), 0 0 8px var(--black), 0 0 18px var(--black); }
  /* a soft dark patch behind each label, so trails never strike through its text */
  .sky-labels li::before { content: ""; position: absolute; inset: -4px -12px; z-index: -1; background: var(--black); opacity: 0.9; filter: blur(9px); border-radius: 12px; }
  .sky-labels li.left { transform: translate(calc(-100% - 16px), -50%); text-align: right; }
  .sky-labels a { display: block; text-decoration: none; padding: 4px 0; }
  .sky-labels .n { font-weight: 500; font-size: 16px;
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.3em; }
  .sky-labels a:hover .n, .sky-labels a:focus-visible .n { text-decoration-thickness: 2px; }
  .sky-labels .l { display: block; margin-top: 5px; font-size: 14px; color: var(--dim); }
  @media (max-width: 759px) {
    .sky-labels .l { display: none; }
    .sky-labels .n { font-size: 14px; }
  }
  .sky-bg { overflow: visible; }
  @media (prefers-reduced-motion: no-preference) {
    .t-head.live { animation: t-breathe 3.2s ease-in-out 3; }
    @keyframes t-breathe { 50% { opacity: 0.5; } }
    /* On load the exposure draws in: faint stars first, then each project from its start to today. */
    .develop .t-bg, .develop .t-line, .t-proj.retrace .t-line { stroke-dasharray: 1 1; stroke-dashoffset: 1;
      animation: t-draw 1.6s cubic-bezier(0.35, 0.1, 0.25, 1) var(--d, 0s) forwards; }
    .develop .t-line { animation-duration: 1.7s; }
    .t-proj.retrace .t-line { animation-duration: 700ms; animation-delay: 0s; }
    .develop :is(.t-head, .t-halo), .develop .sky-labels li { opacity: 0; animation: t-in 300ms ease-out var(--d2, 0s) forwards; }
    .develop .t-head.live { animation: t-in 300ms ease-out var(--d2, 0s) forwards, t-breathe 3.2s ease-in-out calc(var(--d2, 0s) + 300ms) 3; }
    @keyframes t-draw { to { stroke-dashoffset: 0; } }
    @keyframes t-in { to { opacity: 1; } }
    /* Afterwards the background keeps turning around the pole, as the real sky does. */
    .sky-bg.turning { animation: t-turn 720s linear infinite; }
    @keyframes t-turn { to { transform: rotate(360deg); } }
  }
</style>

<script>
  import { layout, svgMarkup, bgMarkup, trailArrives, type TrailProject } from '../lib/trails';

  for (const field of document.querySelectorAll<HTMLElement>('[data-trails]')) {
    const projects: TrailProject[] = JSON.parse(field.dataset.trails!);
    const bg = field.querySelector<SVGSVGElement>('.sky-bg')!;
    const svg = field.querySelector<SVGSVGElement>('.sky-fg')!;
    const list = field.querySelector('ul')!;
    list.hidden = false;

    const draw = () => {
      const W = field.clientWidth, H = field.clientHeight;
      if (!W || !H) return;
      const L = layout(projects, W, H, new Date());
      for (const s of [bg, svg]) s.setAttribute('viewBox', `0 0 ${W} ${H}`);
      bg.innerHTML = bgMarkup(L);
      bg.style.transformOrigin = `${L.cx}px ${L.cy}px`;
      bg.classList.add('turning');
      svg.innerHTML = svgMarkup(L);
      list.replaceChildren();
      for (const t of L.trails) {
        if (!t.label) continue;
        const p = projects[t.i];
        const li = document.createElement('li');
        li.className = t.label.side;
        li.style.left = `${t.head.x}px`;
        li.style.top = `${t.head.y}px`;
        li.style.setProperty('--d2', `${(trailArrives(t.i) - 0.15).toFixed(2)}s`);
        const a = document.createElement('a');
        a.href = p.link;
        a.innerHTML = `<span class="n"></span><span class="l"></span>`;
        a.querySelector('.n')!.textContent = p.name;
        a.querySelector('.l')!.textContent = p.line;
        const group = () => svg.querySelector(`.t-proj[data-i="${t.i}"]`);
        // Pointing at a name lights its trail and traces it again from the start.
        const on = () => {
          const g = group();
          if (!g || field.classList.contains('develop')) { g?.classList.add('on'); return; }
          g.classList.add('on');
          g.classList.remove('retrace');
          void g.getBoundingClientRect();
          g.classList.add('retrace');
        };
        const off = () => group()?.classList.remove('on');
        a.addEventListener('pointerenter', on);
        a.addEventListener('pointerleave', off);
        a.addEventListener('focus', on);
        a.addEventListener('blur', off);
        li.append(a);
        list.append(li);
        // On phones every label sits left of its head; flip only one that would leave the screen.
        if (W < 760) {
          li.className = 'left';
          if (li.getBoundingClientRect().left < 12) {
            // Too long for the space left of its head: wrap onto two lines instead of leaving the screen.
            const room = t.head.x - 28;
            if (room >= 96) { li.style.whiteSpace = 'normal'; li.style.width = room + 'px'; }
            else li.className = 'right';
          }
        }
      }
    };

    draw();
    // Once the first draw-in is over, resizing redraws the sky without replaying it.
    if (field.classList.contains('develop')) {
      const last = Math.max(...projects.map((_, i) => trailArrives(i))) + 0.4;
      setTimeout(() => field.classList.remove('develop'), last * 1000);
    }
    svg.addEventListener('animationend', (e) => (e.target as Element).closest('.retrace')?.classList.remove('retrace'));
    let raf = 0;
    new ResizeObserver(() => { cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); }).observe(field);
  }
</script>
