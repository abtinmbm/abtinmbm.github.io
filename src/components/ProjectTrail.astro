---
// One project's own star trail, for the top of its page. Same rule as the homepage sky:
// the trail's sweep is sqrt(days worked) * 26 degrees, and a live trail has a glowing head.
import { arcPath, sweepFor } from '../lib/trails';

interface Props { start: string; end?: string; }
const { start, end } = Astro.props;
const W = 1440, H = 620;
// The pole sits off the top right, and the radius keeps the bright arc above the title and lead.
const cx = W * 0.9, cy = -H * 0.18, r = W * 0.36, a1 = 152;
const days = ((end ? new Date(end) : new Date()).getTime() - new Date(start).getTime()) / 864e5;
const trail = { r, a0: a1 - sweepFor(days), a1 };
const head = { x: cx + r * Math.cos((a1 * Math.PI) / 180), y: cy + r * Math.sin((a1 * Math.PI) / 180) };

let s = 7;
const rand = () => (s = (s * 16807) % 2147483647) / 2147483647;
const bg = Array.from({ length: 110 }, () => {
  const a0 = rand() * 360;
  return { d: arcPath(cx, cy, { r: 20 + Math.pow(rand(), 0.8) * W * 1.05, a0, a1: a0 + 34 }), w: (0.5 + rand() * 1.1).toFixed(2), o: (0.08 + Math.pow(rand(), 2) * 0.4).toFixed(2) };
});
---
<svg class="ptrail" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMaxYMin slice" aria-hidden="true"
  data-start={start} data-end={end} data-geom={JSON.stringify({ cx, cy, r, a1 })}>
  <defs><radialGradient id="pt-halo"><stop offset="0" stop-color="#fff" stop-opacity=".55" /><stop offset="1" stop-color="#9fb4ff" stop-opacity="0" /></radialGradient></defs>
  {bg.map((b) => <path class="t-bg" d={b.d} stroke-width={b.w} stroke-opacity={b.o} />)}
  <path class="t-line pt-line" d={arcPath(cx, cy, trail)} />
  {!end && <circle class="t-halo pt-halo" cx={head.x} cy={head.y} r="18" />}
  <circle class:list={['t-head', { live: !end }]} cx={head.x} cy={head.y} r={end ? 2.6 : 4} />
</svg>

<style>
  .ptrail { position: absolute; inset: 0; width: 100%; height: 100%; }
  .t-bg { fill: none; stroke: #dfe6ff; stroke-linecap: round; }
  .pt-line { fill: none; stroke: var(--white); stroke-linecap: round; stroke-width: 2.4; }
  .t-head { fill: var(--white); }
  .pt-halo { fill: url(#pt-halo); }
  @media (prefers-reduced-motion: no-preference) {
    .t-head.live { animation: pt-breathe 3.2s ease-in-out infinite; }
    @keyframes pt-breathe { 50% { opacity: 0.5; } }
  }
</style>

<script>
  // Grow the trail to today's length, the same way the homepage sky does.
  import { arcPath, sweepFor } from '../lib/trails';
  for (const svg of document.querySelectorAll<SVGSVGElement>('.ptrail')) {
    if (svg.dataset.end) continue;
    const g = JSON.parse(svg.dataset.geom!);
    const days = (Date.now() - new Date(svg.dataset.start!).getTime()) / 864e5;
    svg.querySelector('.pt-line')?.setAttribute('d', arcPath(g.cx, g.cy, { r: g.r, a0: g.a1 - sweepFor(days), a1: g.a1 }));
  }
</script>
