---
// The homepage sky behind a project page's title: every project's trail, from the same
// geometry as the homepage, drawn faint, with this page's project drawn bright.
// With no slug (the 404) only the background exposure shows.
import { layout, pageSkyMarkup, PAGE_SKY, type TrailProject } from '../lib/trails';
import { projects } from '../data/projects';

interface Props { slug?: string; }
const { slug } = Astro.props;
const sky: TrailProject[] = projects.map((p) => ({ name: p.name, line: p.line, link: p.href ?? '', start: p.start, end: p.end }));
const cur = slug ? projects.findIndex((p) => p.slug === slug) : -1;
const initial = pageSkyMarkup(layout(sky, 1440, 760, new Date(), PAGE_SKY), cur);
---
<svg class="ptrail" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMin slice" aria-hidden="true"
  data-sky={JSON.stringify(sky)} data-cur={cur} set:html={initial} />
<script is:inline>
  // Set before first paint, so the sky draws in instead of flashing complete.
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches) document.currentScript.previousElementSibling.classList.add('develop');
</script>

<style is:global>
  .ptrail { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ptrail .t-bg { fill: none; stroke: #dfe6ff; stroke-linecap: round; }
  .ptrail .pt-line { fill: none; stroke: var(--white); stroke-linecap: round; stroke-width: 1.6; stroke-opacity: 0.16; }
  .ptrail .pt-line.on { stroke-width: 2.6; stroke-opacity: 1; }
  .ptrail .pt-head { fill: var(--white); }
  .ptrail .pt-halo { fill: url(#pt-halo-g); }
  @media (prefers-reduced-motion: no-preference) {
    .ptrail .pt-head.live { animation: pt-breathe 3.2s ease-in-out 3; }
    @keyframes pt-breathe { 50% { opacity: 0.5; } }
    /* On load: the faint sky draws in, then this page's trail traces from its start to its head. */
    .ptrail.develop :is(.t-bg, .pt-line) { stroke-dasharray: 1 1; stroke-dashoffset: 1; animation: pt-draw 1.5s cubic-bezier(0.35, 0.1, 0.25, 1) var(--d, 0s) forwards; }
    .ptrail.develop .pt-line { animation-delay: 0.2s; }
    .ptrail.develop .pt-line.on { animation-duration: 1.8s; animation-delay: 0.5s; }
    .ptrail.develop :is(.pt-head, .pt-halo) { opacity: 0; animation: pt-in 300ms ease-out 2.2s forwards; }
    .ptrail.develop .pt-head.live { animation: pt-in 300ms ease-out 2.2s forwards, pt-breathe 3.2s ease-in-out 2.5s 3; }
    @keyframes pt-draw { to { stroke-dashoffset: 0; } }
    @keyframes pt-in { to { opacity: 1; } }
  }
</style>

<script>
  // Redraw at the real size and today's date, like the homepage sky.
  import { layout, pageSkyMarkup, PAGE_SKY } from '../lib/trails';
  const svgs = [...document.querySelectorAll<SVGSVGElement>('.ptrail')];
  function draw() {
    for (const svg of svgs) {
      const box = svg.getBoundingClientRect();
      const W = Math.round(box.width), H = Math.round(box.height);
      if (!W || !H) continue;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.innerHTML = pageSkyMarkup(layout(JSON.parse(svg.dataset.sky!), W, H, new Date(), PAGE_SKY), Number(svg.dataset.cur));
    }
  }
  draw();
  // Resizing after the draw-in redraws the sky complete, without replaying it.
  setTimeout(() => svgs.forEach((s) => s.classList.remove('develop')), 2800);
  let t = 0;
  addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(draw, 150); });
</script>
