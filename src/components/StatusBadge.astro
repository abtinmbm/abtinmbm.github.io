---
// A project's status as a run-in label. It reads the status from src/data/projects.ts,
// so flipping a pull request to 'merged' there updates every page.
import { projects, statusText } from '../data/projects';

interface Props { slug: string }
const p = projects.find((x) => x.slug === Astro.props.slug)!;
---
<b class:list={['badge', p.status.replace(' ', '-')]}>{statusText[p.status]}</b>

<style>
  .badge { font-weight: 500; color: var(--white); }
  .badge::after { content: "."; }
</style>
