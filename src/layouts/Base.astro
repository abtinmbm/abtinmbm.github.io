---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Header sits over the first screen instead of above it. */
  overlay?: boolean;
  current?: 'home' | 'work' | 'about' | 'resume';
}
const { title, description, overlay = false, current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: '/#work', label: 'Work', key: 'work' },
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/resume/', label: 'Resume', key: 'resume' },
  { href: '/#contact', label: 'Contact', key: 'contact' },
];
---
<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#01030a" />
  <meta name="robots" content="noindex" />
  <link rel="preload" href="/fonts/Panchang-Medium.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Switzer-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class:list={['site-head', { overlay }]}>
    <a class="site-name" href="/" aria-current={current === 'home' ? 'page' : undefined}>Abtin Aryanpour</a>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-foot wrap">
    <p>Abtin Aryanpour, 2026</p>
    {current !== 'home' && <p><a href="mailto:aaryanpo@uwaterloo.ca">aaryanpo@uwaterloo.ca</a></p>}
  </footer>
</body>
</html>

<style>
  .site-head { position: relative; z-index: 10; display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 22px var(--edge); font-size: 15px; font-weight: 500; }
  .site-head.overlay { position: absolute; top: 0; left: 0; right: 0; }
  .site-head a { text-decoration: none; }
  .site-head a:hover, .site-head a:focus-visible, .site-head a[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.3em; }
  .site-head ul { display: flex; gap: clamp(14px, 2vw, 24px); margin: 0; padding: 0; list-style: none; }
  .site-foot { display: flex; justify-content: space-between; gap: 16px; padding-block: 32px 40px; border-top: 1px solid var(--line); font-size: 14px; color: var(--dim); }
  @media (max-width: 420px) {
    .site-head { font-size: 14px; }
    .site-head ul { gap: 12px; }
  }
</style>
