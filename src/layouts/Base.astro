---
import '../styles/global.css';
import PixelIcon from '../components/PixelIcon.astro';
import { featured } from '../data/projects';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'projects' | 'about' | 'resume' | 'photography';
  /** The featured project this page is about, so its taskbar tab shows pressed. */
  project?: string;
}
const { title, description, current, project } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const is404 = Astro.url.pathname.startsWith('/404');
const home = current === 'home';
const projectDesk = Astro.url.pathname === '/projects/';
// One sharing image per page, made by scripts/og-images.mjs.
const ogNames: Record<string, string> = {
  '/': 'home', '/projects/': 'projects', '/projects/andon/': 'andon', '/projects/image-stitcher/': 'image-stitcher',
  '/projects/lloyd/': 'lloyd', '/projects/dose-coach/': 'dose-coach', '/tour/': 'tour',
  '/about/': 'about', '/resume/': 'resume', '/photography/': 'photography',
};
const ogName = is404 ? 'not-found' : ogNames[Astro.url.pathname] ?? 'home';
const ogImage = new URL(`/og/${ogName}.jpg`, Astro.site);
ogImage.searchParams.set('v', ogName === 'home' ? 'projects' : 'desktop');
const ogAlt = home ? 'Abtin Aryanpour’s Workstation portfolio, with the Andon fault replay and a simulated Image Stitcher map.'
  : ogName === 'photography' ? 'A contact sheet of Abtin Aryanpour’s photography.' : `The top of the page: ${title}`;
const nav = [
  { href: '/projects/', label: 'Projects', key: 'projects' },
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/resume/', label: 'Resume', key: 'resume' },
  { href: '/photography/', label: 'Photography', key: 'photography' },
  { href: '/#contact', label: 'Contact', key: 'contact' },
];
const work = featured();
const projectIcon: Partial<Record<string, 'andon' | 'stitcher' | 'lloyd' | 'dose'>> = { andon: 'andon', 'image-stitcher': 'stitcher', lloyd: 'lloyd', 'dose-coach': 'dose' };
// Taskbar tabs open project windows. Detail pages can switch directly between write-ups.
const target = (slug: string, href?: string) => projectDesk ? `#${slug}` : (home ? `/projects/#${slug}` : href ?? `/projects/#${slug}`);
const cmdk = [
  { k: 'Take the demo tour', d: 'Four project demos', h: '/tour/' },
  ...work.map((p) => ({ k: p.name, d: p.team === 'warg' ? 'Project · WARG' : 'Project', h: p.href ?? `/projects/#${p.slug}` })),
  { k: 'All projects', d: 'Demos and Archive', h: '/projects/' },
  { k: 'Archive', d: 'Earlier projects', h: '/projects/#archive' },
  { k: 'About', d: 'Page', h: '/about/' },
  { k: 'Resume', d: 'Page · PDF', h: '/resume/' },
  { k: 'Photography', d: 'Page', h: '/photography/' },
  { k: 'Copy email address', d: 'aryanpourabtin@gmail.com', act: 'copy' },
  { k: 'Switch light / dark', d: 'Theme', act: 'theme' },
  { k: 'GitHub', d: 'github.com/abtinmbm', h: 'https://github.com/abtinmbm' },
  { k: 'LinkedIn', d: 'in/abtin-aryanpour', h: 'https://www.linkedin.com/in/abtin-aryanpour' },
];
const segs = Array.from({ length: 20 });
---
<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!is404 && <link rel="canonical" href={canonical} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=workstation" />
  <meta name="theme-color" content="#e6e4dd" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#141517" media="(prefers-color-scheme: dark)" />
  <meta name="google-site-verification" content="tYC3K6RqLe2dFVx2zk4D99fqNt62pnjfqGGguYiFm7s" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Abtin Aryanpour" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {!is404 && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt} />
  <meta property="og:locale" content="en_CA" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline>
    (() => {
      const r = document.documentElement;
      let t, b;
      try { t = localStorage.getItem('theme'); b = sessionStorage.getItem('booted'); } catch (e) {}
      r.dataset.theme = t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      if (b || matchMedia('(prefers-reduced-motion: reduce)').matches) r.classList.add('no-boot');
      r.classList.add('js');
    })();
  </script>
  <slot name="head" />
</head>
<body>
  <div id="boot" aria-hidden="true">
    <div class="boot-box">
      <div class="tb">AbtinOS</div>
      <div class="bi">
        <PixelIcon name="monitor" />
        <div><p class="boot-name">Abtin Aryanpour</p><p data-boot-status>Starting up…</p></div>
        <div class="segs sunken">{segs.map(() => <i data-seg></i>)}</div>
        <p class="boot-skip">Press any key or tap to skip</p>
      </div>
    </div>
  </div>

  <a class="skip" href="#main">Skip to content</a>
  <header class="topbar raised">
    <a class="brand" href="/" aria-current={home ? 'page' : undefined}><PixelIcon name="monitor" />Abtin Aryanpour</a>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a class="btn nav-btn" href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <span class="sp"></span>
    <div class="tools">
      <button type="button" class="btn sm" data-cmdk aria-keyshortcuts="Control+K Meta+K" hidden>Ctrl K<span class="visually-hidden"> Quick jump</span></button>
      <button type="button" class="rocker" data-sfx-toggle aria-pressed="false" hidden><span class="r-a">SFX off</span><span class="r-b">on</span><span class="visually-hidden"> (sound effects)</span></button>
      <button type="button" class="rocker" data-theme-toggle aria-pressed="false" hidden><span class="r-a">Light</span><span class="r-b">Dark</span><span class="visually-hidden"> theme</span></button>
    </div>
  </header>

  <main class="desk" id="main">
    <slot />
  </main>

  <div id="start-menu" class="raised" hidden>
    <span class="side" aria-hidden="true">AbtinOS</span>
    <ul aria-label="Menu">
      <li><a href="/">Home</a></li>
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      <li><a href="/resume/Abtin-Aryanpour-Resume.pdf">Resume PDF</a></li>
      <li role="presentation"><hr /></li>
      <li><button type="button" data-cmdk>Quick jump <small>Ctrl K</small></button></li>
      <li><button type="button" data-theme-toggle>Light / dark</button></li>
      <li><button type="button" data-sfx-toggle>Sound effects</button></li>
    </ul>
  </div>

  <footer class="taskbar raised">
    <button type="button" class="btn startbtn" data-start aria-expanded="false" aria-controls="start-menu" hidden><PixelIcon name="monitor" /><span class="sl">AbtinOS</span><span class="visually-hidden"> menu</span></button>
    <a class="btn startbtn nojs-home" href="/"><PixelIcon name="monitor" /><span class="sl">AbtinOS</span><span class="visually-hidden"> home</span></a>
    <nav class="tabs" aria-label="Project windows">
      {work.map((p) => (
        <a class="btn tab" href={target(p.slug, p.href)} data-tab={p.slug} data-open={projectDesk ? p.slug : undefined}
          title={p.name} aria-current={project === p.slug ? 'page' : undefined}>
          <PixelIcon name={projectIcon[p.slug] ?? 'monitor'} /><span class="task-label">{p.name}</span>
        </a>
      ))}
    </nav>
    <div class="launchers">
      <a class="btn launcher" href="/resume/Abtin-Aryanpour-Resume.pdf" title="Resume PDF"><PixelIcon name="resume" /><span class="task-label">Resume<span class="visually-hidden"> PDF</span></span></a>
    </div>
    <div class="tray sunken">
      <button type="button" class="btn tray-face" data-tray-face aria-label="Surprise the pixel face" aria-pressed="false" title="Surprise the pixel face" hidden>
        <svg viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
          <path fill="var(--accent)" d="M4 1h8v2h2v2h1v6h-1v2h-2v2H4v-2H2v-2H1V5h1V3h2z" />
          <g fill="var(--on-accent)">
            <path d="M4 5h2v2H4zm6 0h2v2h-2z" />
            <path class="smile" d="M4 9h2v2h4V9h2v2h-2v2H6v-2H4z" />
            <path class="gasp" d="M6 9h4v4H6z" />
          </g>
        </svg>
      </button>
      <time data-time aria-label="Time in Waterloo"></time>
    </div>
  </footer>

  <dialog id="cmdk" aria-label="Quick jump">
    <div class="tb">Quick jump</div>
    <input type="text" placeholder="Jump to…" aria-label="Jump to" role="combobox" aria-expanded="true" aria-controls="ck-list" aria-autocomplete="list" />
    <ul id="ck-list" role="listbox" aria-label="Results"></ul>
  </dialog>
  <span class="visually-hidden" aria-live="polite" data-copy-status></span>
  <script type="application/json" id="cmdk-items" set:html={JSON.stringify(cmdk)} />
  <script is:inline>document.querySelectorAll('[data-cmdk][hidden],[data-sfx-toggle][hidden],[data-theme-toggle][hidden],[data-start][hidden]').forEach(function (b) { b.hidden = false; });</script>
  <script>import '../scripts/os';</script>
</body>
</html>

<style is:global>
  /* ---------- top bar ---------- */
  .topbar { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: 6px; padding: 5px 8px; border-bottom: 1px solid var(--fg); }
  .topbar .brand { font: 400 15px var(--mono); padding: 0 12px 0 6px; text-decoration: none; display: flex; align-items: center; gap: 8px; white-space: nowrap; }
  .topbar .brand .px-icon { width: 18px; height: 18px; }
  .topbar nav ul { display: flex; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .topbar .nav-btn { padding: 8px 12px; box-shadow: none; background: none; }
  .topbar .nav-btn:hover { background: var(--fg); color: var(--panel); }
  .topbar .nav-btn[aria-current] { box-shadow: var(--bevel-press), 0 0 0 1px var(--fg); background: var(--well); }
  .topbar .nav-btn:active { padding: 9px 11px 7px 13px; }
  .topbar .sp { flex: 1; }
  .topbar .tools { display: flex; gap: 6px; align-items: center; }
  .rocker { display: inline-flex; border: 0; padding: 0; cursor: pointer; background: none; font: 400 13px var(--mono); color: var(--fg); box-shadow: 0 0 0 1px var(--fg); }
  .rocker[hidden] { display: none; }
  .rocker span:not(.visually-hidden) { padding: 8px 10px; background: var(--panel); box-shadow: inset 1px 1px 0 var(--hi), inset -1px -1px 0 var(--lo); }
  .rocker[aria-pressed="false"] .r-a, .rocker[aria-pressed="true"] .r-b { background: var(--fg); color: var(--panel); box-shadow: inset 2px 2px 0 var(--shadow); }

  /* ---------- desktop ---------- */
  .desk { max-width: 1480px; margin: 0 auto; padding: 14px 14px 28px; }

  /* ---------- taskbar ---------- */
  .taskbar { position: fixed; inset: auto 0 0; z-index: 30; height: var(--taskbar-height); display: flex; align-items: center; gap: 8px; padding: 4px 8px; border-top: 1px solid var(--fg); }
  .taskbar .btn { height: 36px; padding: 0 9px; white-space: nowrap; }
  .taskbar .btn:active > :is(svg, .task-label) { transform: translate(1px, 1px); }
  .taskbar .px-icon { width: 24px; height: 24px; flex: none; }
  .taskbar [hidden], html:not(.js) .tray { display: none; }
  .startbtn { flex: none; }
  .js .nojs-home { display: none; }
  .startbtn[aria-expanded="true"] { box-shadow: var(--bevel-press), 0 0 0 1px var(--fg); background: var(--fg); color: var(--panel); }
  .startbtn[aria-expanded="true"] .px-icon path[fill="var(--well)"] { fill: var(--panel); }
  .tabs, .launchers { display: flex; gap: 6px; padding-left: 8px; border-left: 1px solid var(--rule); }
  .tab, .launcher { position: relative; font-size: 13px; }
  .tab.in-view, .taskbar a[aria-current]:not([aria-current="false"]) { box-shadow: var(--bevel-press), 0 0 0 1px var(--fg); background: var(--well); }
  .tab.in-view::after, .taskbar a[aria-current="page"]::after { content: ''; position: absolute; inset: auto 4px 2px; height: 2px; background: var(--accent); }
  .tab.is-min { color: var(--mute); }
  .tab.is-min .px-icon { opacity: 0.65; }
  .tray { display: flex; align-items: center; gap: 8px; margin-left: auto; padding: 4px 8px; font: 400 13px var(--mono); white-space: nowrap; flex: none; }
  .taskbar .tray-face { width: 28px; height: 28px; justify-content: center; padding: 0; }
  .tray-face svg { width: 20px; height: 20px; }
  .tray-face .gasp, .tray-face[aria-pressed="true"] .smile { display: none; }
  .tray-face[aria-pressed="true"] .gasp { display: block; }
  .tray time { font-variant-numeric: tabular-nums; }
  .tray time:empty { display: none; }

  #start-menu { position: fixed; left: 6px; bottom: calc(var(--taskbar-height) + 4px); z-index: 40; width: 270px; padding: 3px; box-shadow: var(--bevel), 0 0 0 1px var(--fg), 6px 6px 0 var(--shadow); display: grid; grid-template-columns: 30px 1fr; }
  #start-menu[hidden] { display: none; }
  #start-menu .side { background: var(--accent); color: var(--on-accent); writing-mode: vertical-rl; transform: rotate(180deg); font: 400 15px var(--mono); padding: 10px 6px; }
  #start-menu ul { list-style: none; margin: 0; padding: 4px; }
  #start-menu li a, #start-menu li button { display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 9px 10px; font: 400 14px var(--mono); color: var(--fg); text-decoration: none; background: none; border: 0; cursor: pointer; text-align: left; }
  #start-menu li a:hover, #start-menu li button:hover, #start-menu li a:focus-visible, #start-menu li button:focus-visible { background: var(--fg); color: var(--panel); outline: none; }
  #start-menu li small { color: inherit; opacity: 0.75; font: inherit; }
  #start-menu hr { border: 0; border-top: 1px solid var(--rule); margin: 4px 0; }

  /* ---------- boot ---------- */
  #boot { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; background: var(--desk) var(--wall) repeat; transition: opacity 220ms ease-out; }
  #boot.out { opacity: 0; pointer-events: none; }
  .no-boot #boot, html:not(.js) #boot { display: none; }
  .boot-box { width: min(440px, calc(100vw - 32px)); padding: 3px; background: var(--panel); box-shadow: var(--bevel), 6px 6px 0 var(--shadow); transition: transform 220ms ease-out; }
  #boot.out .boot-box { transform: translateY(-6px) scale(0.98); }
  .boot-box .tb { height: 30px; background: var(--bar-on); color: var(--bar-on-text); display: flex; align-items: center; padding: 0 10px; font: 400 14px var(--mono); }
  .boot-box .bi { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 16px; align-items: center; padding: 20px; }
  .boot-box .px-icon { width: 64px; height: 64px; }
  .boot-name { margin: 0 0 4px; font: 400 24px var(--mono); }
  .boot-box p { font: 400 14px var(--mono); color: var(--mute); }
  .boot-box .boot-name { color: var(--fg); font-size: 24px; }
  .segs { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(20, 1fr); gap: 2px; padding: 4px; }
  .segs i { height: 16px; }
  .segs i.on { background: var(--accent); }
  .boot-skip { grid-column: 1 / -1; font-size: 12px !important; }

  @media (prefers-reduced-motion: no-preference) {
    @view-transition { navigation: auto; }

    ::view-transition-old(root), ::view-transition-new(root) {
      animation-duration: 200ms;
      animation-timing-function: ease-out;
    }
  }

  /* ---------- quick jump ---------- */
  #cmdk { border: 0; padding: 3px; width: min(580px, calc(100vw - 24px)); background: var(--panel); color: var(--fg); margin-top: 14vh; box-shadow: var(--bevel), 0 0 0 1px var(--fg), 8px 8px 0 var(--shadow); }
  #cmdk::backdrop { background: rgb(20 21 23 / 0.3); }
  #cmdk .tb { height: 30px; background: var(--bar-on); color: var(--bar-on-text); font: 400 14px var(--mono); display: flex; align-items: center; padding: 0 10px; }
  #cmdk input { width: calc(100% - 16px); margin: 8px; font: 400 20px var(--mono); padding: 12px; border: 0; color: inherit; background: var(--well); outline: none; box-shadow: var(--bevel-press); }
  #cmdk ul { list-style: none; margin: 0 8px 8px; padding: 0; max-height: 50vh; overflow: auto; }
  #cmdk li { display: flex; justify-content: space-between; gap: 10px; padding: 9px 12px; cursor: pointer; }
  #cmdk li small { color: var(--mute); font-family: var(--mono); }
  #cmdk li[aria-selected="true"] { background: var(--fg); color: var(--panel); }
  #cmdk li[aria-selected="true"] small { color: inherit; }

  /* ---------- phone ---------- */
  @media (max-width: 900px) {
    html { scroll-padding-top: 12px; }
    .desk { padding: 8px 8px 20px; }
    .topbar { flex-wrap: wrap; position: static; }
    .topbar nav { order: 3; width: 100%; }
    .topbar nav ul { flex-wrap: wrap; gap: 3px; }
    .topbar .nav-btn { padding: 8px 5px; font-size: 13px; }
    .topbar .nav-btn:active { padding: 9px 4px 7px 6px; }
    .taskbar { --taskbar-gap: clamp(3px, 1vw, 6px); gap: var(--taskbar-gap); padding-inline: 4px; }
    .taskbar .task-label, .startbtn .sl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
    .taskbar .btn { width: clamp(27px, 8vw, 36px); padding: 0; justify-content: center; }
    .taskbar .px-icon { width: 20px; height: 20px; }
    .tabs, .launchers { gap: var(--taskbar-gap); padding-left: var(--taskbar-gap); }
    .tray { font-size: 11px; padding: 3px 4px; gap: 4px; }
  }
</style>
