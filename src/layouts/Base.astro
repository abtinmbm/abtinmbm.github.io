---
import '../styles/global.css';
import Backdrop from '../components/Backdrop.astro';

interface Props {
  title: string;
  description: string;
  /** Header sits over the first screen instead of above it. */
  overlay?: boolean;
  current?: 'home' | 'work' | 'about' | 'resume' | 'photography';
}
const { title, description, overlay = false, current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const is404 = Astro.url.pathname.startsWith('/404');
// One sharing image per page, made by scripts/og-images.mjs. Pages without one use the homepage's.
const ogNames: Record<string, string> = {
  '/': 'home', '/projects/andon/': 'andon', '/projects/image-stitcher/': 'image-stitcher',
  '/projects/lloyd/': 'lloyd',
  '/about/': 'about', '/resume/': 'resume', '/photography/': 'photography',
};
const ogImage = new URL(`/og/${ogNames[Astro.url.pathname] ?? 'home'}.jpg`, Astro.site);
const nav = [
  { href: '/#work', label: 'Work', key: 'work' },
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/resume/', label: 'Resume', key: 'resume' },
  { href: '/photography/', label: 'Photography', key: 'photography' },
  { href: '/#contact', label: 'Contact', key: 'contact' },
];
---
<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!is404 && <link rel="canonical" href={canonical} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#01030a" />
  <meta name="google-site-verification" content="tYC3K6RqLe2dFVx2zk4D99fqNt62pnjfqGGguYiFm7s" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Abtin Aryanpour" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {!is404 && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`The top of the page: ${title}`} />
  <meta property="og:locale" content="en_CA" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/fonts/Panchang-Medium.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Switzer-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <slot name="head" />
</head>
<body>
  <Backdrop />
  <a class="skip" href="#main">Skip to content</a>
  <header class:list={['site-head', { overlay }]}>
    <a class="site-name" href="/" aria-current={current === 'home' ? 'page' : undefined}>Abtin Aryanpour</a>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-foot wrap">
    <p>Abtin Aryanpour, 2026</p>
    <p class="foot-links"><a href="/photography/">Photography</a>{current !== 'home' && <a href="mailto:aaryanpo@uwaterloo.ca">aaryanpo@uwaterloo.ca</a>}</p>
  </footer>
</body>
</html>

<style>
  .site-head { position: relative; z-index: 10; display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 22px var(--edge); font-size: 15px; font-weight: 500; }
  .site-head.overlay { position: absolute; top: 0; left: 0; right: 0; }
  .site-head a { text-decoration: none; }
  .site-head a:hover, .site-head a:focus-visible, .site-head a[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.3em; }
  .site-head ul { display: flex; gap: clamp(14px, 2vw, 24px); margin: 0; padding: 0; list-style: none; }
  .site-foot { flex-wrap: wrap; }
  .site-foot > p:first-child { white-space: nowrap; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .site-foot { display: flex; justify-content: space-between; gap: 16px; padding-block: 32px 40px; border-top: 1px solid var(--line); font-size: 14px; color: var(--dim); }
  /* On a phone the name gets its own row, so the five links have room. */
  @media (max-width: 599px) {
    .site-head { flex-direction: column; align-items: flex-start; gap: 10px; padding-block: 16px; }
    .site-head ul { gap: 4px 16px; flex-wrap: wrap; }
  }
  @media (max-width: 380px) { .site-head { font-size: 14px; } .site-head ul { gap: 4px 12px; } }
</style>
